<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pulse.desktop.ui.FrontMatchDetailController"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
    <content>
        <VBox spacing="16.0" styleClass="page-root">
            <padding>
                <Insets top="18.0" right="18.0" bottom="22.0" left="18.0"/>
            </padding>

            <VBox spacing="8.0" styleClass="hero-mini-box">
                <Label text="MATCH" styleClass="heroKicker"/>
                <Label fx:id="matchTitleLabel" text="Detail match" styleClass="heroMini__title"/>
                <Label fx:id="matchSummaryLabel" text="Scores, statut et equipes participantes." wrapText="true" styleClass="heroMini__sub"/>
            </VBox>

            <HBox spacing="14.0">
                <VBox spacing="10.0" styleClass="panel" HBox.hgrow="ALWAYS">
                    <Label text="PARTICIPANTS" styleClass="panel-title"/>
                    <VBox fx:id="teamsListBox" spacing="8.0"/>
                </VBox>

                <VBox spacing="10.0" styleClass="panel" prefWidth="400.0" maxWidth="460.0">
                    <Label text="INFOS" styleClass="panel-title"/>

                    <HBox spacing="8.0">
                        <Label text="Status" styleClass="field-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="statusBadgeLabel" text="-" styleClass="badge badge--info"/>
                    </HBox>
                    <HBox spacing="8.0">
                        <Label text="Heure" styleClass="field-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="hourValueLabel" text="-" styleClass="muted"/>
                    </HBox>
                    <HBox spacing="8.0">
                        <Label text="Jeu" styleClass="field-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="gameValueLabel" text="-" styleClass="muted"/>
                    </HBox>
                    <HBox spacing="8.0">
                        <Label text="Categorie" styleClass="field-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="categoryValueLabel" text="-" styleClass="muted"/>
                    </HBox>
                    <HBox spacing="8.0">
                        <Label text="Resultat soumis par" styleClass="field-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="submittedByValueLabel" text="-" styleClass="muted"/>
                    </HBox>
                    <HBox spacing="8.0">
                        <Label text="Match ID" styleClass="field-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="matchIdValueLabel" text="-" styleClass="muted"/>
                    </HBox>
                    <HBox spacing="8.0">
                        <Label text="Gagnant(s)" styleClass="field-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="winnersValueLabel" text="-" styleClass="muted"/>
                    </HBox>

                    <HBox spacing="8.0" styleClass="form-actions-row">
                        <Button text="Retour matchs" onAction="#goBackMatches" styleClass="btn-ghost"/>
                        <Button fx:id="openTournamentButton" text="Voir tournoi" onAction="#openTournamentDetail" styleClass="btn-ghost"/>
                    </HBox>
                </VBox>
            </HBox>
        </VBox>
    </content>
</ScrollPane>
