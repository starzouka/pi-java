<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pulse.desktop.ui.FrontGamesController"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
    <content>
        <VBox spacing="16.0" styleClass="page-root">
            <padding>
                <Insets top="18.0" right="18.0" bottom="22.0" left="18.0"/>
            </padding>

            <VBox spacing="8.0" styleClass="hero-mini-box">
                <Label text="JEUX" styleClass="heroKicker"/>
                <Label text="Catalogue des jeux" styleClass="heroMini__title"/>
                <Label text="Recherche, filtres, score intelligent et tendances." wrapText="true" styleClass="heroMini__sub"/>
            </VBox>

            <VBox spacing="10.0" styleClass="panel">
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label text="CATALOGUE DES JEUX" styleClass="panel-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="resultCountLabel" text="0 jeu(x)" styleClass="badge-soft"/>
                    <Button text="Voir les tournois" onAction="#goTournaments" styleClass="btn-ghost"/>
                </HBox>

                <FlowPane hgap="10.0" vgap="10.0" prefWrapLength="1300.0">
                    <VBox spacing="4.0" prefWidth="340.0">
                        <Label text="Recherche" styleClass="field-label"/>
                        <TextField fx:id="qField" promptText="Rechercher un jeu..." styleClass="input"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="230.0">
                        <Label text="Categorie" styleClass="field-label"/>
                        <ComboBox fx:id="categoryCombo" prefWidth="230.0"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="230.0">
                        <Label text="Publisher" styleClass="field-label"/>
                        <ComboBox fx:id="publisherCombo" prefWidth="230.0"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="220.0">
                        <Label text="Tri" styleClass="field-label"/>
                        <ComboBox fx:id="sortCombo" prefWidth="220.0"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="220.0">
                        <Label text="Option" styleClass="field-label"/>
                        <CheckBox fx:id="activeOnlyCheck" text="Tournois actifs seulement"/>
                    </VBox>
                </FlowPane>

                <HBox spacing="8.0">
                    <Button text="Filtrer" onAction="#applyFilters" styleClass="btn-primary"/>
                    <Button text="Reset" onAction="#resetFilters" styleClass="btn-ghost"/>
                </HBox>
            </VBox>

            <VBox spacing="10.0" styleClass="panel">
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label text="TRENDING GAMES" styleClass="panel-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Classement par score intelligent" styleClass="panel-desc"/>
                </HBox>
                <VBox fx:id="trendingBox" spacing="8.0"/>
            </VBox>

            <VBox spacing="10.0" styleClass="panel">
                <Label text="RESULTATS" styleClass="panel-title"/>
                <VBox fx:id="gamesBox" spacing="8.0"/>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
