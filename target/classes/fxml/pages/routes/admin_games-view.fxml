<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pulse.desktop.ui.AdminGamesController"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
    <content>
        <VBox spacing="16.0" styleClass="page-root">
            <padding>
                <Insets top="18.0" right="18.0" bottom="22.0" left="18.0"/>
            </padding>

            <VBox spacing="8.0" styleClass="hero-mini-box">
                <Label text="ADMIN" styleClass="heroKicker"/>
                <Label text="Gestion jeux" styleClass="heroMini__title"/>
                <Label text="CRUD + slug SEO + score intelligent." wrapText="true" styleClass="heroMini__sub"/>
            </VBox>

            <VBox spacing="10.0" styleClass="panel">
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label fx:id="formTitleLabel" text="NOUVEAU JEU" styleClass="panel-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="KPI Catalogue" onAction="#openCatalogDashboard" styleClass="btn-ghost"/>
                    <Button text="Exporter PDF" onAction="#exportPdf" styleClass="btn-ghost"/>
                    <Button text="Exporter Excel" onAction="#exportExcel" styleClass="btn-ghost"/>
                </HBox>

                <FlowPane hgap="10.0" vgap="10.0" prefWrapLength="1300.0">
                    <VBox spacing="4.0" prefWidth="300.0">
                        <Label text="Nom jeu*" styleClass="field-label"/>
                        <TextField fx:id="nameField" styleClass="input"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="260.0">
                        <Label text="Categorie*" styleClass="field-label"/>
                        <ComboBox fx:id="categoryCombo" prefWidth="260.0"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="220.0">
                        <Label text="Publisher" styleClass="field-label"/>
                        <TextField fx:id="publisherField" styleClass="input"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="180.0">
                        <Label text="Statut*" styleClass="field-label"/>
                        <ComboBox fx:id="statusCombo" prefWidth="180.0"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="260.0">
                        <Label text="Nom cover" styleClass="field-label"/>
                        <TextField fx:id="coverNameField" styleClass="input"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="480.0">
                        <Label text="Cover URL" styleClass="field-label"/>
                        <TextField fx:id="coverUrlField" promptText="https://..." styleClass="input"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="1300.0">
                        <Label text="Description" styleClass="field-label"/>
                        <TextArea fx:id="descriptionArea" prefRowCount="4" wrapText="true" styleClass="textarea"/>
                        <Label fx:id="aiMetaLabel" text="IA: non utilisee" styleClass="list-item-meta"/>
                    </VBox>
                </FlowPane>

                <HBox spacing="8.0">
                    <Button text="AI Suggestion" onAction="#aiSuggest" styleClass="btn-ghost"/>
                    <Button text="AI AutoFill" onAction="#aiAutofill" styleClass="btn-ghost"/>
                    <Button fx:id="saveButton" text="Creer jeu" onAction="#saveGame" styleClass="btn-primary"/>
                    <Button fx:id="cancelEditButton" text="Annuler edition" onAction="#cancelEdit" styleClass="btn-ghost" visible="false" managed="false"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="formFeedbackLabel" text="" styleClass="feedback-label"/>
                </HBox>
            </VBox>

            <VBox spacing="10.0" styleClass="panel">
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label text="FILTRES" styleClass="panel-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="resultCountLabel" text="0 resultat(s)" styleClass="badge-soft"/>
                </HBox>

                <FlowPane hgap="10.0" vgap="10.0" prefWrapLength="1300.0">
                    <VBox spacing="4.0" prefWidth="320.0">
                        <Label text="Recherche" styleClass="field-label"/>
                        <TextField fx:id="qField" promptText="name, slug, desc, publisher" styleClass="input"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="220.0">
                        <Label text="Categorie" styleClass="field-label"/>
                        <ComboBox fx:id="categoryFilterCombo" prefWidth="220.0"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="220.0">
                        <Label text="Publisher" styleClass="field-label"/>
                        <TextField fx:id="publisherFilterField" styleClass="input"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="180.0">
                        <Label text="Statut" styleClass="field-label"/>
                        <ComboBox fx:id="statusFilterCombo" prefWidth="180.0"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="180.0">
                        <Label text="Tri" styleClass="field-label"/>
                        <ComboBox fx:id="sortCombo" prefWidth="180.0"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="150.0">
                        <Label text="Direction" styleClass="field-label"/>
                        <ComboBox fx:id="directionCombo" prefWidth="150.0"/>
                    </VBox>
                </FlowPane>

                <HBox spacing="8.0">
                    <Button text="Filtrer" onAction="#applyFilters" styleClass="btn-primary"/>
                    <Button text="Reset" onAction="#resetFilters" styleClass="btn-ghost"/>
                </HBox>
            </VBox>

            <VBox spacing="10.0" styleClass="panel">
                <Label text="LISTE JEUX" styleClass="panel-title"/>
                <VBox fx:id="gamesListBox" spacing="8.0"/>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
