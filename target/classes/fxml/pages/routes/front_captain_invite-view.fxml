<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pulse.desktop.ui.FrontCaptainInviteController"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
    <content>
        <VBox spacing="16.0" styleClass="page-root">
            <padding>
                <Insets top="18.0" right="18.0" bottom="22.0" left="18.0"/>
            </padding>

            <VBox spacing="8.0" styleClass="hero-mini-box">
                <Label text="CAPITAINE" styleClass="heroKicker"/>
                <Label text="Inviter" styleClass="heroMini__title"/>
                <Label text="Recherche de joueurs et envoi des invitations." wrapText="true" styleClass="heroMini__sub"/>
            </VBox>

            <HBox spacing="14.0" alignment="TOP_LEFT">
                <VBox spacing="8.0" styleClass="panel captain-side-nav" prefWidth="230.0">
                    <Label text="ESPACE CAPITAINE" styleClass="panel-title"/>
                    <Button text="Mon equipe" onAction="#goTeamManage" styleClass="btn-ghost"/>
                    <Button text="Membres" onAction="#goMembers" styleClass="btn-ghost"/>
                    <Button text="Demandes" onAction="#goRequests" styleClass="btn-ghost"/>
                    <Button text="Inviter" styleClass="btn-soft"/>
                    <Button text="Produits" onAction="#goProducts" styleClass="btn-ghost"/>
                    <Button text="Commandes" onAction="#goOrders" styleClass="btn-ghost"/>
                    <Button text="Tournois" onAction="#goTournaments" styleClass="btn-ghost"/>
                </VBox>

                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                    <VBox spacing="8.0" styleClass="panel">
                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                            <Label text="Equipe active" styleClass="field-label"/>
                            <ComboBox fx:id="teamSelectorCombo" onAction="#onTeamSelectionChanged" prefWidth="340.0"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="activeTeamLabel" text="Aucune equipe active" styleClass="panel-desc"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="8.0" styleClass="panel">
                        <Label text="MESSAGERIE SECURISEE" styleClass="panel-title"/>
                        <Label text="Analyse automatique, categories risque et decision metier avant envoi." wrapText="true" styleClass="panel-desc"/>
                        <VBox spacing="6.0">
                            <Label text="Analyse automatique: Detection spam + toxicite." styleClass="list-item-meta"/>
                            <Label text="Categories: scam_recruitment, harassment, aggressive_tone." styleClass="list-item-meta"/>
                            <Label text="Decision: autorisation, avertissement ou blocage." styleClass="list-item-meta"/>
                        </VBox>
                    </VBox>

                    <VBox spacing="10.0" styleClass="panel">
                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                            <Label text="RECHERCHE JOUEURS" styleClass="panel-title"/>
                        </HBox>
                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                            <TextField fx:id="searchField" promptText="Rechercher par username ou nom" styleClass="input" HBox.hgrow="ALWAYS"/>
                            <Button text="Rechercher" onAction="#searchCandidates" styleClass="btn-primary"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="searchCountLabel" text="0 resultat(s)" styleClass="badge-soft"/>
                        </HBox>
                        <Label fx:id="feedbackLabel" text="" styleClass="feedback-label"/>
                    </VBox>

                    <VBox spacing="10.0" styleClass="panel">
                        <Label text="RESULTATS RECHERCHE" styleClass="panel-title"/>
                        <VBox fx:id="candidatesBox" spacing="8.0"/>
                    </VBox>

                    <VBox spacing="10.0" styleClass="panel">
                        <Label text="HISTORIQUE INVITATIONS" styleClass="panel-title"/>
                        <VBox fx:id="historyBox" spacing="8.0"/>
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
    </content>
</ScrollPane>
