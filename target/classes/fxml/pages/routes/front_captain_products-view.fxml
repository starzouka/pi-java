<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pulse.desktop.ui.FrontCaptainProductsController"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
    <content>
        <VBox spacing="16.0" styleClass="page-root">
            <padding>
                <Insets top="18.0" right="18.0" bottom="22.0" left="18.0"/>
            </padding>

            <VBox spacing="8.0" styleClass="hero-mini-box">
                <Label text="CAPITAINE" styleClass="heroKicker"/>
                <Label text="Produits equipe" styleClass="heroMini__title"/>
                <Label text="Meme logique que la page Symfony: filtre + CRUD + detail." wrapText="true" styleClass="heroMini__sub"/>
            </VBox>

            <HBox spacing="14.0" alignment="TOP_LEFT">
                <VBox spacing="8.0" styleClass="panel captain-side-nav" prefWidth="230.0">
                    <Label text="ESPACE CAPITAINE" styleClass="panel-title"/>
                    <Button text="Mon equipe" onAction="#goTeamManage" styleClass="btn-ghost"/>
                    <Button text="Membres" onAction="#goMembers" styleClass="btn-ghost"/>
                    <Button text="Demandes" onAction="#goRequests" styleClass="btn-ghost"/>
                    <Button text="Inviter" onAction="#goInvite" styleClass="btn-ghost"/>
                    <Button text="Produits" styleClass="btn-soft"/>
                    <Button text="Commandes" onAction="#goOrders" styleClass="btn-ghost"/>
                    <Button text="Tournois" onAction="#goTournaments" styleClass="btn-ghost"/>
                </VBox>

                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                    <VBox spacing="8.0" styleClass="panel">
                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                            <Label text="Equipe active" styleClass="field-label"/>
                            <ComboBox fx:id="teamSelectorCombo" onAction="#onTeamSelectionChanged" prefWidth="320.0"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="resultCountLabel" text="0 produit(s)" styleClass="badge-soft"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="10.0" styleClass="panel">
                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                            <Label text="FILTRES" styleClass="panel-title"/>
                        </HBox>
                        <FlowPane hgap="10.0" vgap="10.0" prefWrapLength="1300.0">
                            <VBox spacing="4.0" prefWidth="360.0">
                                <Label text="Recherche" styleClass="field-label"/>
                                <TextField fx:id="qField" promptText="nom, description ou sku" styleClass="input"/>
                            </VBox>
                            <VBox spacing="4.0" prefWidth="220.0">
                                <Label text="Tri" styleClass="field-label"/>
                                <ComboBox fx:id="sortCombo" prefWidth="220.0"/>
                            </VBox>
                            <VBox spacing="4.0" prefWidth="220.0">
                                <Label text="Options" styleClass="field-label"/>
                                <CheckBox fx:id="inactiveCheck" text="Inclure inactifs"/>
                            </VBox>
                        </FlowPane>
                        <HBox spacing="8.0">
                            <Button text="Filtrer" onAction="#applyFilters" styleClass="btn-primary"/>
                            <Button text="Reset" onAction="#resetFilters" styleClass="btn-ghost"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="10.0" styleClass="panel">
                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                            <Label fx:id="formTitleLabel" text="NOUVEAU PRODUIT" styleClass="panel-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="feedbackLabel" text="" styleClass="feedback-label"/>
                        </HBox>
                        <FlowPane hgap="10.0" vgap="10.0" prefWrapLength="1300.0">
                            <VBox spacing="4.0" prefWidth="300.0">
                                <Label text="Nom produit *" styleClass="field-label"/>
                                <TextField fx:id="nameField" styleClass="input"/>
                            </VBox>
                            <VBox spacing="4.0" prefWidth="180.0">
                                <Label text="Prix *" styleClass="field-label"/>
                                <TextField fx:id="priceField" styleClass="input"/>
                            </VBox>
                            <VBox spacing="4.0" prefWidth="150.0">
                                <Label text="Stock *" styleClass="field-label"/>
                                <TextField fx:id="stockField" styleClass="input"/>
                            </VBox>
                            <VBox spacing="4.0" prefWidth="180.0">
                                <Label text="SKU" styleClass="field-label"/>
                                <TextField fx:id="skuField" styleClass="input"/>
                            </VBox>
                            <VBox spacing="4.0" prefWidth="180.0">
                                <Label text="Actif" styleClass="field-label"/>
                                <ComboBox fx:id="activeCombo" prefWidth="180.0"/>
                            </VBox>
                            <VBox spacing="4.0" prefWidth="640.0">
                                <Label text="Image URL" styleClass="field-label"/>
                                <TextField fx:id="imageUrlField" styleClass="input" promptText="https://..."/>
                            </VBox>
                            <VBox spacing="4.0" prefWidth="1300.0">
                                <Label text="Description" styleClass="field-label"/>
                                <TextArea fx:id="descriptionArea" prefRowCount="3" wrapText="true" styleClass="textarea"/>
                            </VBox>
                        </FlowPane>
                        <HBox spacing="8.0">
                            <Button fx:id="saveButton" text="Creer produit" onAction="#saveProduct" styleClass="btn-primary"/>
                            <Button fx:id="cancelEditButton" text="Annuler edition" onAction="#cancelEdit" styleClass="btn-ghost" visible="false" managed="false"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="10.0" styleClass="panel">
                        <Label text="PRODUITS" styleClass="panel-title"/>
                        <VBox fx:id="productsBox" spacing="8.0"/>
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
    </content>
</ScrollPane>

