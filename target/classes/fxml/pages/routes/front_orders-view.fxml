<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pulse.desktop.ui.FrontOrdersController"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
    <content>
        <VBox spacing="16.0" styleClass="page-root">
            <padding>
                <Insets top="18.0" right="18.0" bottom="22.0" left="18.0"/>
            </padding>

            <VBox spacing="8.0" styleClass="hero-mini-box">
                <Label text="JOUEUR" styleClass="heroKicker"/>
                <Label text="Mes commandes" styleClass="heroMini__title"/>
                <Label text="Historique, statuts et acces detail commande." wrapText="true" styleClass="heroMini__sub"/>
            </VBox>

            <HBox spacing="14.0" alignment="TOP_LEFT">
                <VBox spacing="8.0" styleClass="panel side-nav-box" prefWidth="230.0">
                    <Label text="ESPACE JOUEUR" styleClass="panel-title"/>
                    <Button text="Dashboard" onAction="#goDashboard" styleClass="btn-ghost"/>
                    <Button text="Mon profil" onAction="#goProfile" styleClass="btn-ghost"/>
                    <Button text="Recherche joueurs" onAction="#goPlayers" styleClass="btn-ghost"/>
                    <Button text="Amis" onAction="#goFriends" styleClass="btn-ghost"/>
                    <Button text="Messages" onAction="#goMessages" styleClass="btn-ghost"/>
                    <Button text="Fil d'actualite" onAction="#goFeed" styleClass="btn-ghost"/>
                    <Button text="Mes equipes" onAction="#goMyTeams" styleClass="btn-ghost"/>
                    <Button text="Mes demandes" onAction="#goMyRequests" styleClass="btn-ghost"/>
                    <Button text="Mon panier" onAction="#goCart" styleClass="btn-ghost"/>
                    <Button text="Notifications" onAction="#goNotifications" styleClass="btn-ghost"/>
                    <Button text="Mes commandes" styleClass="btn-soft"/>
                </VBox>

                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                    <VBox spacing="10.0" styleClass="panel">
                        <Label text="FILTRES" styleClass="panel-title"/>
                        <FlowPane hgap="10.0" vgap="10.0" prefWrapLength="1300.0">
                            <VBox spacing="4.0" prefWidth="340.0">
                                <Label text="Recherche" styleClass="field-label"/>
                                <TextField fx:id="qField" promptText="Numero, adresse, paiement..." styleClass="input"/>
                            </VBox>
                            <VBox spacing="4.0" prefWidth="180.0">
                                <Label text="Statut" styleClass="field-label"/>
                                <ComboBox fx:id="statusCombo" prefWidth="180.0"/>
                            </VBox>
                            <VBox spacing="4.0" prefWidth="170.0">
                                <Label text="De" styleClass="field-label"/>
                                <DatePicker fx:id="fromDatePicker" prefWidth="170.0"/>
                            </VBox>
                            <VBox spacing="4.0" prefWidth="170.0">
                                <Label text="A" styleClass="field-label"/>
                                <DatePicker fx:id="toDatePicker" prefWidth="170.0"/>
                            </VBox>
                            <VBox spacing="4.0" prefWidth="200.0">
                                <Label text="Tri" styleClass="field-label"/>
                                <ComboBox fx:id="sortCombo" prefWidth="200.0"/>
                            </VBox>
                        </FlowPane>
                        <HBox spacing="8.0">
                            <Button text="Filtrer" onAction="#applyFilters" styleClass="btn-ghost"/>
                            <Button text="Reset" onAction="#resetFilters" styleClass="btn-ghost"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="resultCountLabel" text="0 resultat(s)" styleClass="badge-soft"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="10.0" styleClass="panel">
                        <Label text="COMMANDES" styleClass="panel-title"/>
                        <VBox fx:id="ordersBox" spacing="8.0"/>
                    </VBox>
                </VBox>

                <VBox spacing="10.0" prefWidth="360.0">
                    <VBox spacing="8.0" styleClass="panel">
                        <Label text="RESUME COMMANDES" styleClass="panel-title"/>
                        <HBox spacing="8.0" styleClass="list-item">
                            <Label text="Totales"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="totalLabel" text="0" styleClass="list-item-meta"/>
                        </HBox>
                        <HBox spacing="8.0" styleClass="list-item">
                            <Label text="En livraison"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="shippingLabel" text="0" styleClass="list-item-meta"/>
                        </HBox>
                        <HBox spacing="8.0" styleClass="list-item">
                            <Label text="En attente"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="pendingLabel" text="0" styleClass="list-item-meta"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="8.0" styleClass="panel">
                        <Label text="RACCOURCIS" styleClass="panel-title"/>
                        <Button text="Ouvrir panier" onAction="#goCart" styleClass="btn-ghost"/>
                        <Button text="Retour boutique" onAction="#goShop" styleClass="btn-ghost"/>
                        <Button text="Notifications" onAction="#goNotifications" styleClass="btn-ghost"/>
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
    </content>
</ScrollPane>
