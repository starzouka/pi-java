<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pulse.desktop.ui.AdminTournamentsController"
            fx:id="pageScroll"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
    <content>
        <VBox spacing="16.0" styleClass="page-root">
            <padding>
                <Insets top="18.0" right="18.0" bottom="22.0" left="18.0"/>
            </padding>

            <VBox spacing="8.0" styleClass="hero-mini-box">
                <Label text="ADMIN" styleClass="heroKicker"/>
                <Label text="Gestion tournois" styleClass="heroMini__title"/>
                <Label text="Creation, mise a jour, suppression et suivi des tournois." wrapText="true" styleClass="heroMini__sub"/>
            </VBox>

            <VBox spacing="10.0" styleClass="panel">
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label fx:id="formTitleLabel" text="CREER TOURNOI" styleClass="panel-title"/>
                </HBox>

                <FlowPane hgap="10.0" vgap="10.0" prefWrapLength="1300.0">
                    <VBox spacing="4.0" prefWidth="360.0">
                        <Label text="organizer_user_id*" styleClass="field-label"/>
                        <ComboBox fx:id="organizerCombo" prefWidth="360.0"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="280.0">
                        <Label text="game_id*" styleClass="field-label"/>
                        <ComboBox fx:id="formGameCombo" prefWidth="280.0"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="480.0">
                        <Label text="title*" styleClass="field-label"/>
                        <TextField fx:id="titleField" promptText="Titre tournoi" styleClass="input"/>
                    </VBox>

                    <VBox spacing="4.0" prefWidth="180.0">
                        <Label text="start_date*" styleClass="field-label"/>
                        <DatePicker fx:id="startDatePicker" prefWidth="180.0"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="180.0">
                        <Label text="end_date*" styleClass="field-label"/>
                        <DatePicker fx:id="endDatePicker" prefWidth="180.0"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="220.0">
                        <Label text="registration_deadline" styleClass="field-label"/>
                        <DatePicker fx:id="deadlineDatePicker" prefWidth="220.0"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="140.0">
                        <Label text="max_teams*" styleClass="field-label"/>
                        <TextField fx:id="maxTeamsField" promptText="16" styleClass="input"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="140.0">
                        <Label text="format*" styleClass="field-label"/>
                        <ComboBox fx:id="formatCombo" prefWidth="140.0"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="190.0">
                        <Label text="registration_mode*" styleClass="field-label"/>
                        <ComboBox fx:id="registrationModeCombo" prefWidth="190.0"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="170.0">
                        <Label text="prize_pool*" styleClass="field-label"/>
                        <TextField fx:id="prizePoolField" promptText="0" styleClass="input"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="180.0">
                        <Label text="status*" styleClass="field-label"/>
                        <ComboBox fx:id="formStatusCombo" prefWidth="180.0"/>
                    </VBox>

                    <VBox spacing="4.0" prefWidth="380.0">
                        <Label text="prize_description" styleClass="field-label"/>
                        <TextArea fx:id="prizeDescriptionArea" prefRowCount="3" styleClass="textarea"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="380.0">
                        <Label text="description" styleClass="field-label"/>
                        <TextArea fx:id="descriptionArea" prefRowCount="4" styleClass="textarea"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="380.0">
                        <Label text="rules" styleClass="field-label"/>
                        <TextArea fx:id="rulesArea" prefRowCount="4" styleClass="textarea"/>
                    </VBox>
                </FlowPane>

                <VBox spacing="4.0">
                    <Label text="photo_tournoi" styleClass="field-label"/>
                    <HBox spacing="8.0">
                        <TextField fx:id="photoPathField" promptText="Aucune photo" styleClass="input" HBox.hgrow="ALWAYS"/>
                        <Button text="Choisir" onAction="#choosePhoto" styleClass="btn-ghost"/>
                    </HBox>
                </VBox>

                <HBox spacing="8.0">
                    <Button fx:id="saveTournamentButton" text="Creer tournoi" onAction="#saveTournament" styleClass="btn-primary"/>
                    <Button fx:id="cancelEditButton" text="Annuler edition" onAction="#cancelEdit" styleClass="btn-ghost" visible="false" managed="false"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="formFeedbackLabel" text="" styleClass="feedback-label"/>
                </HBox>
            </VBox>

            <VBox spacing="10.0" styleClass="panel">
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label text="FILTRES" styleClass="panel-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="resultCountLabel" text="0 resultat(s)" styleClass="badge-soft"/>
                    <Button text="Exporter PDF" onAction="#exportPdf" styleClass="btn-ghost"/>
                    <Button text="Exporter Excel" onAction="#exportExcel" styleClass="btn-ghost"/>
                </HBox>

                <FlowPane hgap="10.0" vgap="10.0" prefWrapLength="1300.0">
                    <VBox spacing="4.0" prefWidth="350.0">
                        <Label text="Recherche" styleClass="field-label"/>
                        <TextField fx:id="qField" promptText="Titre, jeu, organisateur..." styleClass="input"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="180.0">
                        <Label text="Status" styleClass="field-label"/>
                        <ComboBox fx:id="statusFilterCombo" prefWidth="180.0"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="230.0">
                        <Label text="Game" styleClass="field-label"/>
                        <ComboBox fx:id="gameFilterCombo" prefWidth="230.0"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="180.0">
                        <Label text="Tri" styleClass="field-label"/>
                        <ComboBox fx:id="sortCombo" prefWidth="180.0"/>
                    </VBox>
                </FlowPane>

                <HBox spacing="8.0">
                    <Button text="Filtrer" onAction="#applyFilters" styleClass="btn-primary"/>
                    <Button text="Reset" onAction="#resetFilters" styleClass="btn-ghost"/>
                </HBox>
            </VBox>

            <VBox spacing="10.0" styleClass="panel">
                <Label text="LISTE DES TOURNOIS" styleClass="panel-title"/>
                <VBox fx:id="tournamentsListBox" spacing="8.0"/>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
