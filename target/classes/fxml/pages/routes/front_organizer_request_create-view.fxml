<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pulse.desktop.ui.FrontOrganizerRequestCreateController"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
    <content>
        <VBox spacing="16.0" styleClass="page-root">
            <padding>
                <Insets top="18.0" right="18.0" bottom="22.0" left="18.0"/>
            </padding>

            <VBox spacing="8.0" styleClass="hero-mini-box">
                <Label text="ORGANISATEUR" styleClass="heroKicker"/>
                <Label text="Demande tournoi" styleClass="heroMini__title"/>
                <Label text="Soumettre une demande complete a l admin." wrapText="true" styleClass="heroMini__sub"/>
            </VBox>

            <HBox spacing="14.0">
                <VBox spacing="8.0" styleClass="panel" prefWidth="250.0">
                    <Label text="Navigation organisateur" styleClass="panel-title"/>
                    <Button text="Mes demandes" onAction="#openOrganizerRequests" styleClass="btn-ghost"/>
                    <Button text="Nouvelle demande" onAction="#cancelToRequests" styleClass="btn-soft"/>
                    <Button text="Gestion matchs" onAction="#openOrganizerMatches" styleClass="btn-ghost"/>
                    <Button text="Inscriptions equipes" onAction="#openOrganizerRegistrations" styleClass="btn-ghost"/>
                </VBox>

                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                    <VBox spacing="10.0" styleClass="panel">
                        <Label text="FORMULAIRE DEMANDE" styleClass="panel-title"/>

                        <FlowPane hgap="10.0" vgap="10.0" prefWrapLength="1160.0">
                            <VBox spacing="4.0" prefWidth="340.0">
                                <Label text="organizer_user_id*" styleClass="field-label"/>
                                <Label fx:id="organizerValueLabel" text="-" styleClass="badge-soft"/>
                            </VBox>
                            <VBox spacing="4.0" prefWidth="280.0">
                                <Label text="game_id*" styleClass="field-label"/>
                                <ComboBox fx:id="gameCombo" prefWidth="280.0"/>
                            </VBox>
                            <VBox spacing="4.0" prefWidth="420.0">
                                <Label text="title*" styleClass="field-label"/>
                                <TextField fx:id="titleField" promptText="Titre du tournoi" styleClass="input"/>
                            </VBox>

                            <VBox spacing="4.0" prefWidth="180.0">
                                <Label text="start_date*" styleClass="field-label"/>
                                <DatePicker fx:id="startDatePicker" prefWidth="180.0"/>
                            </VBox>
                            <VBox spacing="4.0" prefWidth="180.0">
                                <Label text="end_date*" styleClass="field-label"/>
                                <DatePicker fx:id="endDatePicker" prefWidth="180.0"/>
                            </VBox>
                            <VBox spacing="4.0" prefWidth="220.0">
                                <Label text="registration_deadline" styleClass="field-label"/>
                                <DatePicker fx:id="registrationDeadlinePicker" prefWidth="220.0"/>
                            </VBox>
                            <VBox spacing="4.0" prefWidth="140.0">
                                <Label text="max_teams*" styleClass="field-label"/>
                                <TextField fx:id="maxTeamsField" promptText="16" styleClass="input"/>
                            </VBox>
                            <VBox spacing="4.0" prefWidth="160.0">
                                <Label text="format*" styleClass="field-label"/>
                                <ComboBox fx:id="formatCombo" prefWidth="160.0"/>
                            </VBox>
                            <VBox spacing="4.0" prefWidth="200.0">
                                <Label text="registration_mode*" styleClass="field-label"/>
                                <ComboBox fx:id="registrationModeCombo" prefWidth="200.0"/>
                            </VBox>
                            <VBox spacing="4.0" prefWidth="180.0">
                                <Label text="prize_pool*" styleClass="field-label"/>
                                <TextField fx:id="prizePoolField" promptText="0" styleClass="input"/>
                            </VBox>

                            <VBox spacing="4.0" prefWidth="360.0">
                                <Label text="prize_description" styleClass="field-label"/>
                                <TextArea fx:id="prizeDescriptionArea" prefRowCount="3" styleClass="textarea"/>
                            </VBox>
                            <VBox spacing="4.0" prefWidth="360.0">
                                <Label text="description" styleClass="field-label"/>
                                <TextArea fx:id="descriptionArea" prefRowCount="4" styleClass="textarea"/>
                            </VBox>
                            <VBox spacing="4.0" prefWidth="360.0">
                                <Label text="rules" styleClass="field-label"/>
                                <TextArea fx:id="rulesArea" prefRowCount="4" styleClass="textarea"/>
                            </VBox>
                        </FlowPane>

                        <VBox spacing="4.0">
                            <Label text="photo_tournoi" styleClass="field-label"/>
                            <HBox spacing="8.0">
                                <TextField fx:id="photoPathField" promptText="Aucune photo" styleClass="input" HBox.hgrow="ALWAYS"/>
                                <Button text="Choisir" onAction="#choosePhoto" styleClass="btn-ghost"/>
                            </HBox>
                        </VBox>

                        <HBox spacing="8.0">
                            <Button text="Envoyer" onAction="#submitForm" styleClass="btn-primary"/>
                            <Button text="Annuler" onAction="#cancelToRequests" styleClass="btn-ghost"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="feedbackLabel" text="" styleClass="feedback-label"/>
                        </HBox>
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
    </content>
</ScrollPane>
