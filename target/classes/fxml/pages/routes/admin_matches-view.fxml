<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pulse.desktop.ui.AdminMatchesController"
            fx:id="pageScroll"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
    <content>
        <VBox spacing="16.0" styleClass="page-root">
            <padding>
                <Insets top="18.0" right="18.0" bottom="22.0" left="18.0"/>
            </padding>

            <VBox spacing="8.0" styleClass="hero-mini-box">
                <Label text="ADMIN" styleClass="heroKicker"/>
                <Label text="Gestion matchs" styleClass="heroMini__title"/>
                <Label text="CRUD complet + recherche/tri backend." wrapText="true" styleClass="heroMini__sub"/>
            </VBox>

            <VBox spacing="10.0" styleClass="panel">
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label fx:id="formTitleLabel" text="CREER MATCH" styleClass="panel-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Nouveau match" onAction="#startCreate" styleClass="btn-ghost"/>
                </HBox>

                <HBox spacing="10.0">
                    <VBox spacing="4.0" prefWidth="340.0">
                        <Label text="tournoi*" styleClass="field-label"/>
                        <ComboBox fx:id="formTournamentCombo" onAction="#onFormTournamentChanged" prefWidth="340.0"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="240.0">
                        <Label text="round_name" styleClass="field-label"/>
                        <TextField fx:id="roundField" promptText="Quarterfinal / Group A..." styleClass="input"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="170.0">
                        <Label text="scheduled_date" styleClass="field-label"/>
                        <DatePicker fx:id="scheduledDatePicker" prefWidth="170.0"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="130.0">
                        <Label text="scheduled_time" styleClass="field-label"/>
                        <TextField fx:id="scheduledTimeField" promptText="HH:mm" styleClass="input"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="120.0">
                        <Label text="best_of" styleClass="field-label"/>
                        <ComboBox fx:id="bestOfCombo" prefWidth="120.0"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="180.0">
                        <Label text="status*" styleClass="field-label"/>
                        <ComboBox fx:id="formStatusCombo" prefWidth="180.0"/>
                    </VBox>
                </HBox>

                <VBox spacing="6.0">
                    <Label text="equipes_participantes*" styleClass="field-label"/>
                    <VBox fx:id="participantsBox" spacing="6.0"/>
                </VBox>

                <HBox spacing="8.0">
                    <Button fx:id="saveMatchButton" text="Creer match" onAction="#saveMatch" styleClass="btn-primary"/>
                    <Button fx:id="cancelEditButton" text="Annuler edition" onAction="#cancelEdit" styleClass="btn-ghost" visible="false" managed="false"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="formFeedbackLabel" text="" styleClass="feedback-label"/>
                </HBox>
            </VBox>

            <VBox spacing="10.0" styleClass="panel">
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label text="FILTRES" styleClass="panel-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="resultCountLabel" text="0 resultat(s)" styleClass="badge-soft"/>
                    <Button text="Exporter PDF" onAction="#exportPdf" styleClass="btn-ghost"/>
                    <Button text="Exporter Excel" onAction="#exportExcel" styleClass="btn-ghost"/>
                </HBox>

                <FlowPane hgap="10.0" vgap="10.0" prefWrapLength="1300.0">
                    <VBox spacing="4.0" prefWidth="280.0">
                        <Label text="Recherche" styleClass="field-label"/>
                        <TextField fx:id="qField" promptText="Round, tournoi, jeu..." styleClass="input"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="260.0">
                        <Label text="Tournoi" styleClass="field-label"/>
                        <ComboBox fx:id="filterTournamentCombo" prefWidth="260.0"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="180.0">
                        <Label text="Statut" styleClass="field-label"/>
                        <ComboBox fx:id="filterStatusCombo" prefWidth="180.0"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="220.0">
                        <Label text="Jeu" styleClass="field-label"/>
                        <ComboBox fx:id="filterGameCombo" prefWidth="220.0"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="170.0">
                        <Label text="date_from" styleClass="field-label"/>
                        <DatePicker fx:id="filterDateFromPicker" prefWidth="170.0"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="170.0">
                        <Label text="date_to" styleClass="field-label"/>
                        <DatePicker fx:id="filterDateToPicker" prefWidth="170.0"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="220.0">
                        <Label text="team" styleClass="field-label"/>
                        <TextField fx:id="filterTeamField" promptText="Nom equipe" styleClass="input"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="180.0">
                        <Label text="Tri" styleClass="field-label"/>
                        <ComboBox fx:id="filterSortCombo" prefWidth="180.0"/>
                    </VBox>
                </FlowPane>

                <HBox spacing="8.0">
                    <Button text="Filtrer" onAction="#applyFilters" styleClass="btn-primary"/>
                    <Button text="Reset" onAction="#resetFilters" styleClass="btn-ghost"/>
                </HBox>
            </VBox>

            <VBox spacing="10.0" styleClass="panel">
                <Label text="LISTE MATCHS" styleClass="panel-title"/>
                <VBox fx:id="matchesListBox" spacing="8.0"/>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
