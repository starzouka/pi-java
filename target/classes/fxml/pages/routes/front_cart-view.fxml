<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pulse.desktop.ui.FrontCartController"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
    <content>
        <VBox spacing="16.0" styleClass="page-root">
            <padding>
                <Insets top="18.0" right="18.0" bottom="22.0" left="18.0"/>
            </padding>

            <VBox spacing="8.0" styleClass="hero-mini-box">
                <Label text="JOUEUR" styleClass="heroKicker"/>
                <Label text="Mon panier" styleClass="heroMini__title"/>
                <Label text="Gerer les produits et finaliser la commande." wrapText="true" styleClass="heroMini__sub"/>
            </VBox>

            <HBox spacing="14.0" alignment="TOP_LEFT">
                <VBox spacing="8.0" styleClass="panel side-nav-box" prefWidth="230.0">
                    <Label text="ESPACE JOUEUR" styleClass="panel-title"/>
                    <Button text="Dashboard" onAction="#goDashboard" styleClass="btn-ghost"/>
                    <Button text="Mon profil" onAction="#goProfile" styleClass="btn-ghost"/>
                    <Button text="Recherche joueurs" onAction="#goPlayers" styleClass="btn-ghost"/>
                    <Button text="Amis" onAction="#goFriends" styleClass="btn-ghost"/>
                    <Button text="Messages" onAction="#goMessages" styleClass="btn-ghost"/>
                    <Button text="Fil d'actualite" onAction="#goFeed" styleClass="btn-ghost"/>
                    <Button text="Mes equipes" onAction="#goMyTeams" styleClass="btn-ghost"/>
                    <Button text="Mes demandes" onAction="#goMyRequests" styleClass="btn-ghost"/>
                    <Button text="Mes commandes" onAction="#goOrders" styleClass="btn-ghost"/>
                    <Button text="Notifications" onAction="#goNotifications" styleClass="btn-ghost"/>
                    <Button text="Mon panier" styleClass="btn-soft"/>
                </VBox>

                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                    <VBox spacing="10.0" styleClass="panel">
                        <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="panel-head-row">
                            <VBox spacing="4.0">
                                <Label text="ARTICLES DU PANIER" styleClass="panel-title"/>
                                <Label text="Liste des articles filtres" styleClass="panel-desc"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="statusLabel" text="OPEN" styleClass="badge-soft"/>
                        </HBox>

                        <FlowPane hgap="10.0" vgap="10.0" prefWrapLength="1300.0">
                            <VBox spacing="4.0" prefWidth="320.0">
                                <Label text="Recherche" styleClass="field-label"/>
                                <TextField fx:id="qField" promptText="Rechercher un article..." styleClass="input"/>
                            </VBox>
                            <VBox spacing="4.0" prefWidth="250.0">
                                <Label text="Equipe" styleClass="field-label"/>
                                <ComboBox fx:id="teamCombo" prefWidth="250.0"/>
                            </VBox>
                            <VBox spacing="4.0" prefWidth="250.0">
                                <Label text="Tri" styleClass="field-label"/>
                                <ComboBox fx:id="sortCombo" prefWidth="250.0"/>
                            </VBox>
                        </FlowPane>

                        <HBox spacing="8.0">
                            <Button text="Filtrer" onAction="#applyFilters" styleClass="btn-ghost"/>
                            <Button text="Reset" onAction="#resetFilters" styleClass="btn-ghost"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="feedbackLabel" text="" styleClass="feedback-label"/>
                        </HBox>

                        <VBox fx:id="itemsBox" spacing="8.0"/>
                    </VBox>
                </VBox>

                <VBox spacing="10.0" prefWidth="360.0">
                    <VBox spacing="8.0" styleClass="panel">
                        <Label text="RESUME" styleClass="panel-title"/>
                        <HBox spacing="8.0" styleClass="list-item">
                            <Label text="Articles"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="totalQtyLabel" text="0" styleClass="list-item-meta"/>
                        </HBox>
                        <HBox spacing="8.0" styleClass="list-item">
                            <Label text="Sous-total"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="subtotalLabel" text="0.00 DT" styleClass="list-item-meta"/>
                        </HBox>
                        <HBox spacing="8.0" styleClass="list-item">
                            <Label text="Articles affiches"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="visibleQtyLabel" text="0" styleClass="list-item-meta"/>
                        </HBox>
                        <HBox spacing="8.0" styleClass="list-item">
                            <Label text="Sous-total affiche"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="visibleSubtotalLabel" text="0.00 DT" styleClass="list-item-meta"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="8.0" styleClass="panel">
                        <Label text="PASSER COMMANDE" styleClass="panel-title"/>
                        <VBox spacing="4.0">
                            <Label text="Adresse livraison" styleClass="field-label"/>
                            <TextField fx:id="shippingAddressField" promptText="Adresse" styleClass="input"/>
                        </VBox>
                        <VBox spacing="4.0">
                            <Label text="Telephone" styleClass="field-label"/>
                            <TextField fx:id="phoneField" promptText="Telephone" styleClass="input"/>
                        </VBox>
                        <VBox spacing="4.0">
                            <Label text="Paiement" styleClass="field-label"/>
                            <ComboBox fx:id="paymentMethodCombo" prefWidth="300.0"/>
                        </VBox>
                        <Button text="Passer commande" onAction="#checkout" styleClass="btn-primary"/>
                    </VBox>

                    <VBox spacing="8.0" styleClass="panel">
                        <Label text="RACCOURCIS" styleClass="panel-title"/>
                        <Button text="Retour boutique" onAction="#goShop" styleClass="btn-ghost"/>
                        <Button text="Mes commandes" onAction="#goOrders" styleClass="btn-ghost"/>
                        <Button text="Notifications" onAction="#goNotifications" styleClass="btn-ghost"/>
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
    </content>
</ScrollPane>
