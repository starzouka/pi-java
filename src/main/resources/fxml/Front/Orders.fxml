<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.OrdersController"
            stylesheets="@../../css/style_front.css">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="hero-top" prefHeight="70">
            <VBox alignment="CENTER_LEFT" spacing="-2">
                <Label text="PULSE" styleClass="brand-name" style="-fx-font-size: 20;"/>
                <Label text="mes commandes" styleClass="brand-small" style="-fx-font-size: 9;"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <HBox spacing="8" alignment="CENTER" styleClass="topbar" style="-fx-padding: 4;">
                <Button text="RETOUR BOUTIQUE" onAction="#goBack" styleClass="topbar-item" style="-fx-padding: 6 14; -fx-font-size: 12;"/>
                <Button text="MES COMMANDES" styleClass="topbar-item, topbar-item-active" style="-fx-padding: 6 14; -fx-font-size: 12;"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS" />
            <HBox spacing="12" alignment="CENTER_RIGHT">
                <Button text="RAFRAÎCHIR" onAction="#loadOrders" styleClass="btn-ghost" style="-fx-text-fill: #ffd24a; -fx-border-color: rgba(255,210,74,0.3); -fx-padding: 8 18; -fx-font-size: 12;"/>
            </HBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <content>
                <VBox spacing="20">
                    <padding>
                        <Insets top="30" right="40" bottom="30" left="40"/>
                    </padding>

                    <!-- Titre Section -->
                    <VBox alignment="CENTER" spacing="5">
                        <Label text="SUIVI D'ACTIVITÉ" styleClass="section-label" style="-fx-font-size: 10;"/>
                        <Label text="Historique" styleClass="hero-title" style="-fx-font-size: 36;"/>
                        <Label text="Retrouvez le détail de vos transactions passées" styleClass="label-muted" style="-fx-font-size: 14;"/>
                    </VBox>

                    <!-- Table Container (Style .card) -->
                    <VBox styleClass="orders-card" spacing="0" maxWidth="1200" alignment="CENTER">

                        <!-- Orders Header Section -->
                        <HBox styleClass="orders-header-section" alignment="CENTER_LEFT">
                            <padding>
                                <Insets top="28" right="30" bottom="22" left="30"/>
                            </padding>
                            <VBox spacing="4">
                                <Label text="\uD83D\uDCCB MES COMMANDES" styleClass="card-section-title"/>
                                <Label text="Historique de vos achats et transactions" styleClass="label-muted" style="-fx-font-size: 13;"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <TextField promptText="\uD83D\uDD0D Rechercher par numéro..." styleClass="search-field-modern" prefWidth="300"/>
                        </HBox>

                        <Separator style="-fx-opacity: 0.08;"/>

                        <!-- Orders Table -->
                        <TableView fx:id="orderTable" styleClass="orders-table-modern" prefHeight="360">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <columns>
                                <TableColumn text="NUMÉRO" prefWidth="150">
                                    <cellValueFactory><PropertyValueFactory property="orderNumber"/></cellValueFactory>
                                </TableColumn>
                                <TableColumn text="DATE DE COMMANDE" prefWidth="180" style="-fx-alignment: center;">
                                    <cellValueFactory><PropertyValueFactory property="createdAt"/></cellValueFactory>
                                </TableColumn>
                                <TableColumn text="MONTANT TOTAL" prefWidth="150" styleClass="column-subtotal">
                                    <cellValueFactory><PropertyValueFactory property="totalAmount"/></cellValueFactory>
                                </TableColumn>
                                <TableColumn text="STATUT" prefWidth="160" styleClass="column-status" style="-fx-alignment: center;">
                                    <cellValueFactory><PropertyValueFactory property="status"/></cellValueFactory>
                                </TableColumn>
                                <TableColumn text="PAIEMENT" prefWidth="160" styleClass="column-payment" style="-fx-alignment: center;">
                                    <cellValueFactory><PropertyValueFactory property="paymentStatus"/></cellValueFactory>
                                </TableColumn>
                            </columns>
                        </TableView>

                        <Separator style="-fx-opacity: 0.08;"/>

                        <!-- Footer Actions -->
                        <HBox styleClass="orders-footer-section" alignment="CENTER_RIGHT">
                            <padding>
                                <Insets top="20" right="30" bottom="25" left="30"/>
                            </padding>
                            <Button text="RAFRAÎCHIR ↻" onAction="#loadOrders" styleClass="btn-refresh-orders" prefHeight="42" style="-fx-font-size: 12; -fx-font-weight: 800;"/>
                        </HBox>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
