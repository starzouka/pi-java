<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.lang.String?>
<?import javafx.collections.FXCollections?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.CheckoutController"
            stylesheets="@../../css/style_front.css">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="hero-top" prefHeight="70">
            <!-- BRAND LOGO (Pulse) -->
            <VBox alignment="CENTER_LEFT" spacing="-2">
                <Label text="PULSE" styleClass="brand-name" style="-fx-font-size: 20;"/>
                <Label text="e-sport arena" styleClass="brand-small" style="-fx-font-size: 9;"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <!-- MAIN TOPBAR NAVIGATION -->
            <HBox spacing="8" alignment="CENTER" styleClass="topbar" style="-fx-padding: 4;">
                <Button text="RETOUR AU PANIER" onAction="#goBack" styleClass="topbar-item" style="-fx-padding: 6 14; -fx-font-size: 12;"/>
                <Button text="FINALISATION" styleClass="topbar-item, topbar-item-active" style="-fx-padding: 6 14; -fx-font-size: 12;"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS" />
            <HBox spacing="12" alignment="CENTER_RIGHT">
                <Label text="SECURE PAYMENT" styleClass="label-muted" style="-fx-font-size: 10; -fx-font-weight: 800;"/>
                <Button text="ANNULER" onAction="#goBack" styleClass="btn-ghost" style="-fx-padding: 8 18; -fx-font-size: 12;"/>
            </HBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <content>
                <VBox spacing="20" alignment="TOP_CENTER">
                    <padding>
                        <Insets top="30" right="40" bottom="30" left="40"/>
                    </padding>

                    <!-- Titre Section -->
                    <VBox alignment="CENTER" spacing="5">
                        <Label text="FINALISER VOTRE COMMANDE" styleClass="section-label" style="-fx-font-size: 10;"/>
                        <Label text="Checkout" styleClass="hero-title" style="-fx-font-size: 36;"/>
                    </VBox>

                    <HBox spacing="30" alignment="TOP_CENTER" maxWidth="1100">

                        <!-- Formulaire de Livraison -->
                        <VBox styleClass="checkout-form-card" HBox.hgrow="ALWAYS" maxWidth="550" spacing="0">

                            <!-- Form Header -->
                            <VBox styleClass="form-header-section">
                                <padding>
                                    <Insets top="25" right="25" bottom="20" left="25"/>
                                </padding>
                                <Label text="📦" style="-fx-font-size: 30;"/>
                                <Label text="COORDONNÉES DE LIVRAISON" style="-fx-font-size: 18; -fx-font-weight: 900; -fx-text-fill: white;"/>
                                <Label text="Informations de livraison et contact" styleClass="label-muted" style="-fx-font-size: 12;"/>
                            </VBox>

                            <Separator style="-fx-opacity: 0.08;"/>

                            <!-- Form Fields -->
                            <VBox spacing="18" styleClass="form-fields-container">
                                <padding>
                                    <Insets top="20" right="25" bottom="25" left="25"/>
                                </padding>

                                <VBox spacing="6">
                                    <Label text="ADRESSE E-MAIL *" styleClass="field-label-required" style="-fx-font-size: 10;"/>
                                    <TextField fx:id="emailField" promptText="exemple@pulse.com" styleClass="text-field-modern" prefHeight="45"/>
                                </VBox>

                                <VBox spacing="6">
                                    <Label text="TÉLÉPHONE *" styleClass="field-label-required" style="-fx-font-size: 10;"/>
                                    <TextField fx:id="phoneField" promptText="+216 00 000 000" styleClass="text-field-modern" prefHeight="45"/>
                                </VBox>

                                <VBox spacing="6">
                                    <Label text="ADRESSE DE LIVRAISON *" styleClass="field-label-required" style="-fx-font-size: 10;"/>
                                    <TextArea fx:id="addressField" promptText="Votre adresse complète..." prefHeight="80" styleClass="text-area-modern" wrapText="true"/>
                                </VBox>

                                <VBox spacing="6">
                                    <Label text="MÉTHODE DE PAIEMENT *" styleClass="field-label-required" style="-fx-font-size: 10;"/>
                                    <ComboBox fx:id="paymentMethodCombo" promptText="Sélectionner..." styleClass="text-field-modern" prefWidth="Infinity" prefHeight="45">
                                        <items>
                                            <FXCollections fx:factory="observableArrayList">
                                                <String fx:value="CARD"/>
                                                <String fx:value="CASH"/>
                                                <String fx:value="OTHER"/>
                                            </FXCollections>
                                        </items>
                                    </ComboBox>
                                </VBox>
                            </VBox>

                            <Separator style="-fx-opacity: 0.08;"/>

                            <!-- Submit Button Section -->
                            <VBox styleClass="form-action-section">
                                <padding>
                                    <Insets top="20" right="25" bottom="25" left="25"/>
                                </padding>
                                <Button text="CONFIRMER ET PAYER →" onAction="#confirmOrder"
                                        styleClass="btn-confirm-order" maxWidth="Infinity" prefHeight="50"
                                        style="-fx-font-size: 14; -fx-font-weight: 900;"/>
                            </VBox>
                        </VBox>

                        <!-- Résumé de commande -->
                        <VBox styleClass="order-summary-card-modern" HBox.hgrow="ALWAYS" maxWidth="450" spacing="0">

                            <!-- Summary Header -->
                            <VBox styleClass="summary-header-section">
                                <padding>
                                    <Insets top="25" right="25" bottom="20" left="25"/>
                                </padding>
                                <Label text="🛒" style="-fx-font-size: 30;"/>
                                <Label text="RÉCAPITULATIF COMMANDE" style="-fx-font-size: 18; -fx-font-weight: 900; -fx-text-fill: white;"/>
                                <Label text="Articles dans votre commande" styleClass="label-muted" style="-fx-font-size: 12;"/>
                            </VBox>

                            <Separator style="-fx-opacity: 0.08;"/>

                            <!-- Order Items Table -->
                            <TableView fx:id="orderSummaryTable" styleClass="order-summary-table" prefHeight="180">
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                                <columns>
                                    <TableColumn text="PRODUIT" prefWidth="190">
                                        <cellValueFactory><PropertyValueFactory property="productName"/></cellValueFactory>
                                    </TableColumn>
                                    <TableColumn text="QTY" prefWidth="60" style="-fx-alignment: center;">
                                        <cellValueFactory><PropertyValueFactory property="quantity"/></cellValueFactory>
                                    </TableColumn>
                                    <TableColumn text="TOTAL" prefWidth="110" styleClass="column-subtotal">
                                        <cellValueFactory><PropertyValueFactory property="totalPrice"/></cellValueFactory>
                                    </TableColumn>
                                </columns>
                            </TableView>

                            <Separator style="-fx-opacity: 0.08;"/>

                            <!-- Total & Security Section -->
                            <VBox spacing="15" styleClass="summary-footer-section">
                                <padding>
                                    <Insets top="20" right="25" bottom="25" left="25"/>
                                </padding>

                                <VBox alignment="CENTER_RIGHT" spacing="4">
                                    <Label text="MONTANT TOTAL" styleClass="label-muted" style="-fx-font-size: 9; -fx-font-weight: 800;"/>
                                    <Label fx:id="totalLabel" text="0.00 DT" styleClass="checkout-total-amount" style="-fx-font-size: 30;"/>
                                </VBox>

                                <!-- Security Badge -->
                                <VBox spacing="10" styleClass="security-badge" style="-fx-padding: 12;">
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Label text="🛡️" style="-fx-font-size: 20;"/>
                                        <VBox spacing="2">
                                            <Label text="Paiement sécurisé" style="-fx-font-size: 12; -fx-font-weight: 800; -fx-text-fill: #28ff8a;"/>
                                            <Label text="Transaction chiffrée SSL" styleClass="label-muted" style="-fx-font-size: 10;"/>
                                        </VBox>
                                    </HBox>
                                </VBox>
                            </VBox>
                        </VBox>
                    </HBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
