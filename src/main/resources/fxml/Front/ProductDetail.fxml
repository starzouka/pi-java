<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.ProductDetailController"
            stylesheets="@../../css/style_front.css">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="hero-top" prefHeight="70">
            <!-- BRAND LOGO (Pulse) -->
            <VBox alignment="CENTER_LEFT" spacing="-2">
                <Label text="PULSE" styleClass="brand-name" style="-fx-font-size: 20;"/>
                <Label text="e-sport arena" styleClass="brand-small" style="-fx-font-size: 9;"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <!-- MAIN TOPBAR NAVIGATION -->
            <HBox spacing="8" alignment="CENTER" styleClass="topbar" style="-fx-padding: 4;">
                <Button text="Accueil" styleClass="topbar-item" onAction="#goBack" style="-fx-padding: 6 14; -fx-font-size: 12;"/>
                <Button text="Boutique" styleClass="topbar-item, topbar-item-active" onAction="#goBack" style="-fx-padding: 6 14; -fx-font-size: 12;"/>
                <Button text="Détails" styleClass="topbar-item" style="-fx-padding: 6 14; -fx-font-size: 12;"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <!-- AUTH & ACCOUNT -->
            <HBox spacing="12" alignment="CENTER_RIGHT">
                <Button text="RETOUR" onAction="#goBack" styleClass="btn-ghost" style="-fx-padding: 8 18; -fx-font-size: 12;"/>
                <Button text="PANIER" onAction="#goToCart" styleClass="btn-signin" style="-fx-padding: 8 18; -fx-font-size: 12;"/>
            </HBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <content>
                <VBox spacing="20" alignment="CENTER">
                    <padding>
                        <Insets top="30" right="40" bottom="30" left="40"/>
                    </padding>

                    <!-- HERO MINI SECTION -->
                    <VBox spacing="5" alignment="CENTER">
                        <Label text="BOUTIQUE" styleClass="section-label" style="-fx-font-size: 10;"/>
                        <Label text="Détails du Produit" styleClass="hero-title" style="-fx-font-size: 36;"/>
                    </VBox>

                    <VBox styleClass="product-detail-card" maxWidth="1100" spacing="0">
                        
                        <!-- Product Detail Header -->
                        <HBox styleClass="detail-header-section" alignment="CENTER_LEFT">
                            <padding>
                                <Insets top="25" right="35" bottom="20" left="35"/>
                            </padding>
                            <Label text="\uD83D\uDECD\uFE0F DÉTAILS PRODUIT" styleClass="card-section-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="RETOUR BOUTIQUE" onAction="#goBack" styleClass="btn-back-outline" prefHeight="38" style="-fx-font-size: 11;"/>
                        </HBox>

                        <Separator style="-fx-opacity: 0.08;"/>

                        <!-- Main Content Section -->
                        <HBox spacing="60" alignment="TOP_CENTER" styleClass="detail-content-section">
                            <padding>
                                <Insets top="40" right="45" bottom="45" left="45"/>
                            </padding>

                            <!-- Colonne de gauche: Image du Produit -->
                            <VBox prefWidth="400" prefHeight="400" styleClass="product-image-container">
                                <StackPane VBox.vgrow="ALWAYS" style="-fx-alignment: center;">
                                    <ImageView fx:id="productImageView" fitWidth="360" fitHeight="360" preserveRatio="true" styleClass="product-main-image">
                                        <clip>
                                            <javafx.scene.shape.Rectangle arcWidth="24" arcHeight="24" width="360" height="360"/>
                                        </clip>
                                    </ImageView>
                                    <Label text="📷" style="-fx-font-size: 80; -fx-opacity: 0.12;" visible="false" fx:id="imagePlaceholder"/>
                                </StackPane>
                            </VBox>

                            <!-- Colonne de droite: Infos -->
                            <VBox spacing="30" HBox.hgrow="ALWAYS" styleClass="product-info-section">
                                
                                <!-- Product Title & Status -->
                                <VBox spacing="10">
                                    <Label fx:id="statusLabel" text="✓ DISPONIBLE EN STOCK" styleClass="product-status-badge"/>
                                    <Label fx:id="nameLabel" text="NOM DU PRODUIT" styleClass="product-title-display"/>
                                </VBox>

                                <Separator style="-fx-opacity: 0.08;"/>

                                <!-- Description Section -->
                                <VBox spacing="10">
                                    <Label text="DESCRIPTION DU PRODUIT" styleClass="info-section-label"/>
                                    <TextArea fx:id="descriptionLabel" wrapText="true" editable="false"
                                              styleClass="product-description-area"
                                              prefHeight="150"/>
                                </VBox>

                                <!-- Price & Stock Info -->
                                <HBox spacing="50" alignment="CENTER_LEFT" styleClass="price-stock-row">
                                    <VBox spacing="6">
                                        <Label text="PRIX UNITAIRE" styleClass="info-label-small"/>
                                        <Label fx:id="priceLabel" text="0.00 DT" styleClass="product-price-display"/>
                                    </VBox>
                                    <VBox spacing="6">
                                        <Label text="STOCK DISPONIBLE" styleClass="info-label-small"/>
                                        <Label fx:id="stockLabel" text="0" styleClass="product-stock-display"/>
                                    </VBox>
                                </HBox>

                                <Separator style="-fx-opacity: 0.08;"/>

                                <!-- Quantity Selector & Add to Cart -->
                                <VBox spacing="24" styleClass="purchase-action-section">
                                    <HBox spacing="35" alignment="CENTER_LEFT">
                                        <VBox spacing="10">
                                            <Label text="QUANTITÉ" styleClass="info-label-small"/>
                                            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="quantity-selector-modern">
                                                <Button text="−" onAction="#decreaseQuantity" styleClass="quantity-btn-modern quantity-btn-minus"/>
                                                <TextField fx:id="quantityField" text="1" prefWidth="75" styleClass="quantity-input-field"/>
                                                <Button text="+" onAction="#increaseQuantity" styleClass="quantity-btn-modern quantity-btn-plus"/>
                                            </HBox>
                                        </VBox>

                                        <Region HBox.hgrow="ALWAYS"/>

                                        <VBox alignment="CENTER_RIGHT" spacing="6">
                                            <Label text="SOUS-TOTAL" styleClass="info-label-small"/>
                                            <Label fx:id="subtotalLabel" text="0.00 DT" styleClass="subtotal-display-large"/>
                                        </VBox>
                                    </HBox>

                                    <Button text="AJOUTER AU PANIER 🛒" onAction="#addToCart"
                                            styleClass="btn-add-to-cart-primary" prefHeight="64" maxWidth="Infinity"
                                            style="-fx-font-size: 16; -fx-font-weight: 900; -fx-letter-spacing: 1.5px;"/>
                                </VBox>
                            </VBox>
                        </HBox>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
