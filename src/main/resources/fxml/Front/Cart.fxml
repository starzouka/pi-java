<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.CartController"
            stylesheets="@../../css/style_front.css">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="hero-top" prefHeight="70">
            <!-- BRAND LOGO (Pulse) -->
            <VBox alignment="CENTER_LEFT" spacing="-2">
                <Label text="PULSE" styleClass="brand-name" style="-fx-font-size: 20;"/>
                <Label text="e-sport arena" styleClass="brand-small" style="-fx-font-size: 9;"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <!-- MAIN TOPBAR NAVIGATION -->
            <HBox spacing="8" alignment="CENTER" styleClass="topbar" style="-fx-padding: 4;">
                <Button text="Accueil" styleClass="topbar-item" onAction="#goBack" style="-fx-padding: 6 14; -fx-font-size: 12;"/>
                <Button text="Boutique" styleClass="topbar-item" onAction="#goBack" style="-fx-padding: 6 14; -fx-font-size: 12;"/>
                <Button text="Panier" styleClass="topbar-item, topbar-item-active" style="-fx-padding: 6 14; -fx-font-size: 12;"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <!-- AUTH & ACCOUNT -->
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="SIGN IN" styleClass="btn-signin" style="-fx-padding: 8 18; -fx-font-size: 12;"/>
            </HBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <content>
                <VBox spacing="20">
                    <padding>
                        <Insets top="30" right="40" bottom="30" left="40"/>
                    </padding>

                    <!-- Titre Section -->
                    <VBox alignment="CENTER" spacing="5">
                        <Label text="RÉCAPITULATIF" styleClass="section-label" style="-fx-font-size: 10;"/>
                        <Label text="Votre Panier" styleClass="hero-title" style="-fx-font-size: 36;"/>
                    </VBox>

                    <!-- Table Container (Style .card) -->
                    <VBox styleClass="cart-card" spacing="0" maxWidth="1000" alignment="CENTER">
                        
                        <!-- Table Header Section -->
                        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 15 25 12 25;">
                            <VBox spacing="4">
                                <Label text="ARTICLES DANS LE PANIER" style="-fx-font-size: 16; -fx-font-weight: 900; -fx-text-fill: white;"/>
                                <Label text="Gérez vos produits avant de passer à la caisse" styleClass="label-muted" style="-fx-font-size: 11;"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="VIDER PANIER" onAction="#clearCart" styleClass="btn-danger-outline" prefHeight="32" style="-fx-padding: 0 15; -fx-font-size: 10;"/>
                        </HBox>

                        <Separator style="-fx-opacity: 0.1;"/>

                        <!-- Modern Products Table -->
                        <TableView fx:id="cartTable" styleClass="cart-table-modern" prefHeight="320">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="imageCol" text="IMAGE" prefWidth="80" resizable="false" style="-fx-alignment: center;"/>
                                <TableColumn fx:id="nameCol" text="PRODUIT" prefWidth="250">
                                    <cellValueFactory><PropertyValueFactory property="productName" /></cellValueFactory>
                                </TableColumn>
                                <TableColumn fx:id="priceCol" text="PRIX UNIT." prefWidth="110" styleClass="column-price">
                                    <cellValueFactory><PropertyValueFactory property="unitPriceAtAdd" /></cellValueFactory>
                                </TableColumn>
                                <TableColumn fx:id="quantityCol" text="QUANTITÉ" prefWidth="130" style="-fx-alignment: center;">
                                    <cellValueFactory><PropertyValueFactory property="quantity" /></cellValueFactory>
                                </TableColumn>
                                <TableColumn fx:id="subtotalCol" text="SOUS-TOTAL" prefWidth="110" styleClass="column-subtotal">
                                    <cellValueFactory><PropertyValueFactory property="totalPrice" /></cellValueFactory>
                                </TableColumn>
                                <TableColumn fx:id="actionCol" text="ACTION" prefWidth="70" resizable="false" style="-fx-alignment: center;"/>
                            </columns>
                        </TableView>

                        <Separator style="-fx-opacity: 0.1;"/>

                        <!-- Footer Section with Total & Buttons -->
                        <VBox spacing="15" style="-fx-padding: 20;">
                            <HBox alignment="CENTER_RIGHT" spacing="30">
                                <HBox spacing="8" alignment="CENTER_LEFT" styleClass="cart-stats" style="-fx-padding: 6 12;">
                                    <Label text="📦" style="-fx-font-size: 12;"/>
                                    <VBox spacing="0">
                                        <Label text="ARTICLES" styleClass="label-muted" style="-fx-font-size: 8; -fx-font-weight: 800;"/>
                                        <Label fx:id="itemsCountLabel" text="0 articles" style="-fx-font-size: 11; -fx-font-weight: 900; -fx-text-fill: white;"/>
                                    </VBox>
                                </HBox>

                                <Region HBox.hgrow="ALWAYS" />

                                <VBox alignment="CENTER_RIGHT" spacing="4">
                                    <Label text="TOTAL À PAYER" styleClass="label-muted" style="-fx-font-weight: 900; -fx-font-size: 9;"/>
                                    <Label fx:id="totalLabel" text="0.00 DT" styleClass="cart-total-amount" style="-fx-font-size: 30;"/>
                                </VBox>
                            </HBox>

                            <Separator style="-fx-opacity: 0.1;"/>

                            <HBox spacing="12" alignment="CENTER_RIGHT">
                                <Button text="CONTINUER MES ACHATS" onAction="#goBack" styleClass="btn-ghost-modern" prefHeight="45" prefWidth="200" style="-fx-font-size: 11;"/>
                                <Button text="VALIDER LA COMMANDE →" onAction="#checkout" styleClass="btn-checkout-primary" prefHeight="45" prefWidth="230" style="-fx-font-size: 12; -fx-font-weight: 900;"/>
                            </HBox>
                        </VBox>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
