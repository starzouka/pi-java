<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pulse.desktop.ui.FrontTeamsController"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
    <content>
        <VBox spacing="16.0" styleClass="page-root">
            <padding>
                <Insets top="18.0" right="18.0" bottom="22.0" left="18.0"/>
            </padding>

            <VBox spacing="8.0" styleClass="hero-mini-box">
                <Label text="EQUIPES" styleClass="heroKicker"/>
                <Label text="Catalogue des equipes" styleClass="heroMini__title"/>
                <Label text="Recherche, filtres et tri directement depuis la base de donnees." wrapText="true" styleClass="heroMini__sub"/>
            </VBox>

            <VBox spacing="10.0" styleClass="panel">
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label text="CATALOGUE" styleClass="panel-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="resultCountLabel" text="0 equipe(s)" styleClass="badge-soft"/>
                    <Button text="Voir les tournois" onAction="#openTournaments" styleClass="btn-ghost"/>
                </HBox>
            </VBox>

            <VBox spacing="10.0" styleClass="panel">
                <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="panel-head-row">
                    <Label text="FILTRES" styleClass="panel-title"/>
                </HBox>

                <FlowPane hgap="10.0" vgap="10.0" prefWrapLength="1300.0">
                    <VBox spacing="4.0" prefWidth="300.0">
                        <Label text="Recherche" styleClass="field-label"/>
                        <TextField fx:id="qField" promptText="Rechercher une equipe..." styleClass="input"/>
                    </VBox>

                    <VBox spacing="4.0" prefWidth="220.0">
                        <Label text="Region" styleClass="field-label"/>
                        <ComboBox fx:id="regionCombo" prefWidth="220.0"/>
                    </VBox>

                    <VBox spacing="4.0" prefWidth="190.0">
                        <Label text="Tri" styleClass="field-label"/>
                        <ComboBox fx:id="sortCombo" prefWidth="190.0"/>
                    </VBox>
                </FlowPane>

                <HBox spacing="12.0" alignment="CENTER_LEFT">
                    <CheckBox fx:id="withProductsCheck" text="Avec produits" styleClass="muted"/>
                    <CheckBox fx:id="activeTournamentsCheck" text="Actives en tournois" styleClass="muted"/>
                </HBox>

                <HBox spacing="8.0">
                    <Button text="Filtrer" onAction="#applyFilters" styleClass="btn-primary"/>
                    <Button text="Reset" onAction="#resetFilters" styleClass="btn-ghost"/>
                </HBox>
            </VBox>

            <VBox spacing="10.0" styleClass="panel">
                <Label text="RESULTATS" styleClass="panel-title"/>
                <FlowPane fx:id="teamsPane" hgap="12.0" vgap="12.0" prefWrapLength="1400.0"/>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
