<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pulse.desktop.ui.FrontShopController"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
    <content>
        <VBox spacing="16.0" styleClass="page-root">
            <padding>
                <Insets top="18.0" right="18.0" bottom="22.0" left="18.0"/>
            </padding>

            <VBox spacing="8.0" styleClass="hero-mini-box">
                <Label text="BOUTIQUE" styleClass="heroKicker"/>
                <Label text="Catalogue produits" styleClass="heroMini__title"/>
                <Label text="Meme structure Symfony: filtres, details, equipe, ajout panier." wrapText="true" styleClass="heroMini__sub"/>
            </VBox>

            <VBox spacing="10.0" styleClass="panel">
                <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <Label text="CATALOGUE" styleClass="panel-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="resultCountLabel" text="0 produit(s)" styleClass="badge-soft"/>
                    <Label fx:id="cartCountLabel" text="Panier (0)" styleClass="badge-soft"/>
                    <Button text="Assistant boutique" onAction="#openChatbot" styleClass="btn-soft"/>
                    <Button text="Panier" onAction="#openCart" styleClass="btn-ghost"/>
                    <Button text="Mes commandes" onAction="#openOrders" styleClass="btn-ghost"/>
                </HBox>
            </VBox>

            <VBox spacing="10.0" styleClass="panel">
                <Label text="FILTRES" styleClass="panel-title"/>
                <FlowPane hgap="10.0" vgap="10.0" prefWrapLength="1300.0">
                    <VBox spacing="4.0" prefWidth="320.0">
                        <Label text="Recherche" styleClass="field-label"/>
                        <TextField fx:id="qField" styleClass="input" promptText="Rechercher un produit..."/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="250.0">
                        <Label text="Equipe" styleClass="field-label"/>
                        <ComboBox fx:id="teamCombo" prefWidth="250.0"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="160.0">
                        <Label text="Prix min" styleClass="field-label"/>
                        <TextField fx:id="minField" styleClass="input"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="160.0">
                        <Label text="Prix max" styleClass="field-label"/>
                        <TextField fx:id="maxField" styleClass="input"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="210.0">
                        <Label text="Tri" styleClass="field-label"/>
                        <ComboBox fx:id="sortCombo" prefWidth="210.0"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="160.0">
                        <Label text="Stock" styleClass="field-label"/>
                        <CheckBox fx:id="stockCheck" text="En stock"/>
                    </VBox>
                </FlowPane>
                <HBox spacing="8.0">
                    <Button text="Filtrer" onAction="#applyFilters" styleClass="btn-primary"/>
                    <Button text="Reset" onAction="#resetFilters" styleClass="btn-ghost"/>
                </HBox>
            </VBox>

            <VBox spacing="10.0" styleClass="panel">
                <Label text="PRODUITS" styleClass="panel-title"/>
                <VBox fx:id="productsBox" spacing="8.0"/>
            </VBox>
        </VBox>
    </content>
</ScrollPane>

