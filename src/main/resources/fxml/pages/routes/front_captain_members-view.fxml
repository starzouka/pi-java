<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pulse.desktop.ui.FrontCaptainMembersController"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
    <content>
        <VBox spacing="16.0" styleClass="page-root">
            <padding>
                <Insets top="18.0" right="18.0" bottom="22.0" left="18.0"/>
            </padding>

            <VBox spacing="8.0" styleClass="hero-mini-box">
                <Label text="CAPITAINE" styleClass="heroKicker"/>
                <Label text="Membres" styleClass="heroMini__title"/>
                <Label text="Gestion des membres de l'equipe active." wrapText="true" styleClass="heroMini__sub"/>
            </VBox>

            <HBox spacing="14.0" alignment="TOP_LEFT">
                <VBox spacing="8.0" styleClass="panel captain-side-nav" prefWidth="230.0">
                    <Label text="ESPACE CAPITAINE" styleClass="panel-title"/>
                    <Button text="Mon equipe" onAction="#goTeamManage" styleClass="btn-ghost"/>
                    <Button text="Membres" styleClass="btn-soft"/>
                    <Button text="Demandes" onAction="#goRequests" styleClass="btn-ghost"/>
                    <Button text="Inviter" onAction="#goInvite" styleClass="btn-ghost"/>
                    <Button text="Produits" onAction="#goProducts" styleClass="btn-ghost"/>
                    <Button text="Commandes" onAction="#goOrders" styleClass="btn-ghost"/>
                    <Button text="Tournois" onAction="#goTournaments" styleClass="btn-ghost"/>
                </VBox>

                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                    <VBox spacing="8.0" styleClass="panel">
                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                            <Label text="Equipe active" styleClass="field-label"/>
                            <ComboBox fx:id="teamSelectorCombo" onAction="#onTeamSelectionChanged" prefWidth="340.0"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="activeTeamLabel" text="Aucune equipe active" styleClass="panel-desc"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="10.0" styleClass="panel">
                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                            <Label text="MEMBRES ACTIFS" styleClass="panel-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="Actifs" styleClass="muted"/>
                            <Label fx:id="activeCountLabel" text="0" styleClass="badge-soft"/>
                            <Button text="Exporter fiche roster (PDF)" onAction="#exportRosterPdf" styleClass="btn-ghost"/>
                        </HBox>

                        <FlowPane hgap="10.0" vgap="10.0" prefWrapLength="1300.0">
                            <VBox spacing="4.0" styleClass="statCard" prefWidth="160.0">
                                <Label text="CAPTAIN" styleClass="statCard__label"/>
                                <Label fx:id="rosterCaptainLabel" text="0" styleClass="statCard__value"/>
                            </VBox>
                            <VBox spacing="4.0" styleClass="statCard" prefWidth="160.0">
                                <Label text="CO_CAPTAIN" styleClass="statCard__label"/>
                                <Label fx:id="rosterCoCaptainLabel" text="0" styleClass="statCard__value"/>
                            </VBox>
                            <VBox spacing="4.0" styleClass="statCard" prefWidth="160.0">
                                <Label text="STARTER" styleClass="statCard__label"/>
                                <Label fx:id="rosterStarterLabel" text="0" styleClass="statCard__value"/>
                            </VBox>
                            <VBox spacing="4.0" styleClass="statCard" prefWidth="160.0">
                                <Label text="SUBSTITUTE" styleClass="statCard__label"/>
                                <Label fx:id="rosterSubstituteLabel" text="0" styleClass="statCard__value"/>
                            </VBox>
                        </FlowPane>

                        <Label fx:id="feedbackLabel" text="" styleClass="feedback-label"/>
                        <VBox fx:id="activeMembersBox" spacing="8.0"/>
                    </VBox>

                    <VBox spacing="10.0" styleClass="panel">
                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                            <Label text="ANCIENS MEMBRES" styleClass="panel-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="Historique" styleClass="muted"/>
                            <Label fx:id="inactiveCountLabel" text="0" styleClass="badge-soft"/>
                        </HBox>
                        <VBox fx:id="inactiveMembersBox" spacing="8.0"/>
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
    </content>
</ScrollPane>
