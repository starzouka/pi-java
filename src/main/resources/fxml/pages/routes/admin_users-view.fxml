<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pulse.desktop.ui.AdminUsersController"
            fx:id="pageScroll"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
    <content>
        <VBox spacing="16.0" styleClass="page-root">
            <padding>
                <Insets top="18.0" right="18.0" bottom="22.0" left="18.0"/>
            </padding>

            <VBox spacing="8.0" styleClass="hero-mini-box">
                <Label text="ADMIN" styleClass="heroKicker"/>
                <Label text="Gestion utilisateurs" styleClass="heroMini__title"/>
                <Label text="Recherche/filtre DB + CRUD + exports." wrapText="true" styleClass="heroMini__sub"/>
            </VBox>

            <VBox spacing="10.0" styleClass="panel adminUsersStats">
                <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="panel-head-row">
                    <Label text="STATISTIQUES UTILISATEURS" styleClass="panel-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="resultCountLabel" text="0 resultat(s)" styleClass="badge-soft"/>
                </HBox>

                <FlowPane hgap="10.0" vgap="10.0" prefWrapLength="1300.0">
                    <VBox spacing="4.0" styleClass="statCard" prefWidth="170.0">
                        <Label text="Total" styleClass="statCard__label"/>
                        <Label fx:id="statsTotalLabel" text="0" styleClass="statCard__value"/>
                    </VBox>
                    <VBox spacing="4.0" styleClass="statCard" prefWidth="170.0">
                        <Label text="Actifs" styleClass="statCard__label"/>
                        <Label fx:id="statsActiveLabel" text="0" styleClass="statCard__value"/>
                    </VBox>
                    <VBox spacing="4.0" styleClass="statCard" prefWidth="170.0">
                        <Label text="Inactifs" styleClass="statCard__label"/>
                        <Label fx:id="statsInactiveLabel" text="0" styleClass="statCard__value"/>
                    </VBox>
                    <VBox spacing="4.0" styleClass="statCard" prefWidth="170.0">
                        <Label text="Email verifies" styleClass="statCard__label"/>
                        <Label fx:id="statsVerifiedLabel" text="0" styleClass="statCard__value"/>
                    </VBox>
                    <VBox spacing="4.0" styleClass="statCard" prefWidth="170.0">
                        <Label text="2FA active" styleClass="statCard__label"/>
                        <Label fx:id="statsTwoFactorLabel" text="0" styleClass="statCard__value"/>
                    </VBox>
                    <VBox spacing="4.0" styleClass="statCard" prefWidth="170.0">
                        <Label text="Nouveaux (30j)" styleClass="statCard__label"/>
                        <Label fx:id="statsNewUsersLabel" text="0" styleClass="statCard__value"/>
                    </VBox>
                    <VBox spacing="4.0" styleClass="statCard" prefWidth="170.0">
                        <Label text="Connexions (7j)" styleClass="statCard__label"/>
                        <Label fx:id="statsRecentLoginLabel" text="0" styleClass="statCard__value"/>
                    </VBox>
                </FlowPane>

                <HBox spacing="12.0">
                    <VBox spacing="8.0" styleClass="panel" HBox.hgrow="ALWAYS">
                        <Label text="Repartition par role" styleClass="panel-title"/>
                        <VBox fx:id="roleBarsBox" spacing="8.0"/>
                    </VBox>
                    <VBox spacing="8.0" styleClass="panel" HBox.hgrow="ALWAYS">
                        <Label text="Top pays" styleClass="panel-title"/>
                        <VBox fx:id="countryBarsBox" spacing="8.0"/>
                    </VBox>
                </HBox>
            </VBox>

            <VBox spacing="10.0" styleClass="panel">
                <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="panel-head-row">
                    <Label text="FILTRES" styleClass="panel-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Creer utilisateur" onAction="#openCreate" styleClass="btn-primary"/>
                    <Button text="Exporter PDF" onAction="#exportPdf" styleClass="btn-ghost"/>
                    <Button text="Exporter Excel" onAction="#exportExcel" styleClass="btn-ghost"/>
                </HBox>

                <FlowPane hgap="10.0" vgap="10.0" prefWrapLength="1300.0">
                    <VBox spacing="4.0" prefWidth="300.0">
                        <Label text="Recherche" styleClass="field-label"/>
                        <TextField fx:id="qField" promptText="username, email, display name" styleClass="input"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="180.0">
                        <Label text="Role" styleClass="field-label"/>
                        <ComboBox fx:id="roleCombo" prefWidth="180.0"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="170.0">
                        <Label text="Actif" styleClass="field-label"/>
                        <ComboBox fx:id="activeCombo" prefWidth="170.0"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="170.0">
                        <Label text="Email verifie" styleClass="field-label"/>
                        <ComboBox fx:id="verifiedCombo" prefWidth="170.0"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="190.0">
                        <Label text="Tri" styleClass="field-label"/>
                        <ComboBox fx:id="sortCombo" prefWidth="190.0"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="150.0">
                        <Label text="Direction" styleClass="field-label"/>
                        <ComboBox fx:id="directionCombo" prefWidth="150.0"/>
                    </VBox>
                </FlowPane>

                <HBox spacing="8.0">
                    <Button text="Filtrer" onAction="#applyFilters" styleClass="btn-primary"/>
                    <Button text="Reset" onAction="#resetFilters" styleClass="btn-ghost"/>
                </HBox>
            </VBox>

            <VBox spacing="10.0" styleClass="panel">
                <Label text="LISTE" styleClass="panel-title"/>
                <VBox fx:id="usersListBox" spacing="8.0"/>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
