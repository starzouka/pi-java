<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pulse.desktop.ui.FrontOrganizerRequestsController"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
    <content>
        <VBox spacing="16.0" styleClass="page-root">
            <padding>
                <Insets top="18.0" right="18.0" bottom="22.0" left="18.0"/>
            </padding>

            <VBox spacing="8.0" styleClass="hero-mini-box">
                <Label text="ORGANISATEUR" styleClass="heroKicker"/>
                <Label text="Mes demandes" styleClass="heroMini__title"/>
                <Label text="Suivi detaille des demandes de tournoi envoyees." wrapText="true" styleClass="heroMini__sub"/>
            </VBox>

            <HBox spacing="14.0">
                <VBox spacing="8.0" styleClass="panel" prefWidth="250.0">
                    <Label text="Navigation organisateur" styleClass="panel-title"/>
                    <Button text="Mes demandes" onAction="#openOrganizerRequests" styleClass="btn-soft"/>
                    <Button text="Nouvelle demande" onAction="#openCreateRequest" styleClass="btn-ghost"/>
                    <Button text="Gestion matchs" onAction="#openOrganizerMatches" styleClass="btn-ghost"/>
                    <Button text="Inscriptions equipes" onAction="#openOrganizerRegistrations" styleClass="btn-ghost"/>
                </VBox>

                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                    <VBox spacing="10.0" styleClass="panel">
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <Label text="DEMANDES ENVOYEES" styleClass="panel-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="countLabel" text="0 demande(s)" styleClass="badge-soft"/>
                            <Button text="PDF" onAction="#exportPdf" styleClass="btn-ghost"/>
                            <Button text="Excel" onAction="#exportExcel" styleClass="btn-ghost"/>
                            <Button text="Nouvelle demande" onAction="#openCreateRequest" styleClass="btn-primary"/>
                        </HBox>

                        <FlowPane hgap="10.0" vgap="10.0" prefWrapLength="1160.0">
                            <VBox spacing="4.0" prefWidth="280.0">
                                <Label text="q" styleClass="field-label"/>
                                <TextField fx:id="qField" promptText="Rechercher une demande..." styleClass="input"/>
                            </VBox>
                            <VBox spacing="4.0" prefWidth="180.0">
                                <Label text="status" styleClass="field-label"/>
                                <ComboBox fx:id="statusCombo" prefWidth="180.0"/>
                            </VBox>
                            <VBox spacing="4.0" prefWidth="240.0">
                                <Label text="game" styleClass="field-label"/>
                                <ComboBox fx:id="gameCombo" prefWidth="240.0"/>
                            </VBox>
                            <VBox spacing="4.0" prefWidth="170.0">
                                <Label text="sort" styleClass="field-label"/>
                                <ComboBox fx:id="sortCombo" prefWidth="170.0"/>
                            </VBox>
                        </FlowPane>

                        <HBox spacing="8.0">
                            <Button text="Filtrer" onAction="#applyFilters" styleClass="btn-primary"/>
                            <Button text="Reset" onAction="#resetFilters" styleClass="btn-ghost"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="10.0" styleClass="panel">
                        <Label text="LISTE" styleClass="panel-title"/>
                        <VBox fx:id="requestsListBox" spacing="8.0"/>
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
    </content>
</ScrollPane>
