<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pulse.desktop.ui.FrontGamesController"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
    <content>
        <VBox fx:id="pageRoot" spacing="16.0" styleClass="page-root">
            <padding>
                <Insets top="18.0" right="18.0" bottom="22.0" left="18.0"/>
            </padding>

            <VBox spacing="8.0" styleClass="hero-mini-box">
                <Label text="PULSE FRONT" styleClass="heroKicker"/>
                <Label fx:id="routeNameLabel" text="Catalogue des jeux" styleClass="heroMini__title"/>
                <Label fx:id="routeDescriptionLabel" text="Structure synchronisee avec templates/front/pages/games.html.twig" wrapText="true" styleClass="heroMini__sub"/>
                <HBox spacing="8.0" styleClass="breadcrumbs-row">
                    <Label text="Accueil" styleClass="muted"/>
                    <Label text=">" styleClass="muted"/>
                    <Label fx:id="routeIdLabel" text="Route Symfony: front_games" styleClass="muted"/>
                </HBox>
            </VBox>

            <VBox spacing="8.0" styleClass="panel">
                <Label text="SECTIONS" styleClass="panel-title"/>
                <Label text="- Catalogue des jeux" styleClass="muted"/>
                <Label text="- Trending Games" styleClass="muted"/>
            </VBox>

            <VBox spacing="10.0" styleClass="panel">
                <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="panel-head-row">
                    <Label text="FILTRES" styleClass="panel-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Catalogue" styleClass="badge-soft"/>
                </HBox>
                <FlowPane hgap="8.0" vgap="8.0" prefWrapLength="1200.0">
                    <VBox spacing="4.0" prefWidth="280.0">
                        <Label text="q" styleClass="field-label"/>
                        <TextField fx:id="qField" promptText="Rechercher (nom, slug, description)" styleClass="input"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="280.0">
                        <Label text="category" styleClass="field-label"/>
                        <ComboBox fx:id="categoryBox" promptText="Categorie" styleClass="input"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="280.0">
                        <Label text="publisher" styleClass="field-label"/>
                        <TextField fx:id="publisherField" promptText="Editeur" styleClass="input"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="280.0">
                        <Label text="sort" styleClass="field-label"/>
                        <ComboBox fx:id="sortBox" promptText="Tri" styleClass="input"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="280.0">
                        <Label text="status" styleClass="field-label"/>
                        <ComboBox fx:id="statusBox" promptText="Statut" styleClass="input"/>
                    </VBox>
                </FlowPane>
                <HBox spacing="8.0" styleClass="form-actions-row">
                    <Button fx:id="filterButton" text="Filtrer" styleClass="btn-primary"/>
                    <Button fx:id="resetButton" text="Reset" styleClass="btn-ghost"/>
                </HBox>
            </VBox>

            <VBox spacing="10.0" styleClass="panel">
                <Label text="ACTIONS" styleClass="panel-title"/>
                <FlowPane hgap="8.0" vgap="8.0" prefWrapLength="1200.0">
                    <Button text="Voir les tournois" onAction="#goToTournaments" styleClass="btn-ghost"/>
                    <Button text="Reset filtres" onAction="#resetFilters" styleClass="btn-ghost"/>
                </FlowPane>
            </VBox>

            <VBox spacing="10.0" styleClass="panel">
                <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="panel-head-row">
                    <VBox spacing="4.0">
                        <Label fx:id="sectionHeadingLabel" text="RESULTATS" styleClass="panel-title"/>
                        <Label fx:id="sectionSubheadingLabel" text="Elements lies a cette page." styleClass="panel-desc"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Refresh" onAction="#refreshGames" styleClass="btn-ghost"/>
                    <Button id="nav__front_home__home" text="Accueil" onAction="#goHome" styleClass="btn-soft"/>
                </HBox>
                <FlowPane fx:id="cardsPane" hgap="12.0" vgap="12.0" styleClass="cards-grid" prefWrapLength="1300.0"/>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
