<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pulse.desktop.ui.FrontTournamentDetailController"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
    <content>
        <VBox spacing="16.0" styleClass="page-root">
            <padding>
                <Insets top="18.0" right="18.0" bottom="22.0" left="18.0"/>
            </padding>

            <VBox spacing="8.0" styleClass="hero-mini-box">
                <Label text="TOURNOI" styleClass="heroKicker"/>
                <Label fx:id="titleLabel" text="Titre tournoi" styleClass="heroMini__title"/>
                <Label fx:id="subtitleLabel" text="Organisateur | Jeu | Format" wrapText="true" styleClass="heroMini__sub"/>
            </VBox>

            <HBox spacing="14.0">
                <VBox spacing="10.0" styleClass="panel" HBox.hgrow="ALWAYS">
                    <VBox fx:id="coverPane" prefHeight="160.0" styleClass="card__media"/>
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label fx:id="progressLabel" text="0 match(s) termine(s) / 0" styleClass="badge-soft"/>
                        <Label fx:id="registrationsLabel" text="Equipes: 0/0" styleClass="badge-soft"/>
                    </HBox>

                    <HBox spacing="8.0" styleClass="tabs">
                        <Button fx:id="tabOverviewButton" text="Apercu" onAction="#openTabOverview" styleClass="tab tab--active"/>
                        <Button fx:id="tabScoresButton" text="Classement" onAction="#openTabScores" styleClass="tab"/>
                        <Button fx:id="tabMatchesButton" text="Matchs" onAction="#openTabMatches" styleClass="tab"/>
                        <Button fx:id="tabTeamsButton" text="Equipes" onAction="#openTabTeams" styleClass="tab"/>
                    </HBox>

                    <VBox fx:id="overviewPane" spacing="8.0">
                        <VBox fx:id="overviewListBox" spacing="8.0"/>
                    </VBox>

                    <VBox fx:id="scoresPane" spacing="8.0" managed="false" visible="false">
                        <VBox fx:id="scoresListBox" spacing="8.0"/>
                    </VBox>

                    <VBox fx:id="matchesPane" spacing="8.0" managed="false" visible="false">
                        <VBox fx:id="matchesListBox" spacing="8.0"/>
                    </VBox>

                    <VBox fx:id="teamsPane" spacing="8.0" managed="false" visible="false">
                        <VBox fx:id="teamsListBox" spacing="8.0"/>
                    </VBox>
                </VBox>

                <VBox spacing="10.0" styleClass="panel" prefWidth="360.0" maxWidth="420.0">
                    <Label text="INSCRIPTIONS" styleClass="panel-title"/>
                    <VBox spacing="4.0">
                        <Label text="team_id" styleClass="field-label"/>
                        <ComboBox fx:id="teamCombo" prefWidth="320.0"/>
                    </VBox>
                    <Button fx:id="participateButton" text="Participer" onAction="#participate" styleClass="btn-primary"/>
                    <Label fx:id="feedbackLabel" text="" wrapText="true" styleClass="feedback-label"/>
                </VBox>
            </HBox>
        </VBox>
    </content>
</ScrollPane>
