<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pulse.desktop.ui.AdminStatisticsController"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
    <content>
        <VBox spacing="16.0" styleClass="page-root">
            <padding>
                <Insets top="18.0" right="18.0" bottom="22.0" left="18.0"/>
            </padding>

            <VBox spacing="8.0" styleClass="hero-mini-box">
                <Label text="ADMIN" styleClass="heroKicker"/>
                <Label text="Statistiques produits et commandes" styleClass="heroMini__title"/>
                <Label text="KPIs, ventes, top produits et notes." wrapText="true" styleClass="heroMini__sub"/>
            </VBox>

            <HBox spacing="8.0" alignment="CENTER_LEFT" styleClass="panel">
                <Label text="Periode" styleClass="field-label"/>
                <ComboBox fx:id="daysCombo" prefWidth="130.0"/>
                <Button text="Actualiser" onAction="#refresh" styleClass="btn-primary"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="periodLabel" text="-" styleClass="badge-soft"/>
            </HBox>

            <FlowPane hgap="10.0" vgap="10.0" prefWrapLength="1300.0" styleClass="panel">
                <VBox spacing="4.0" styleClass="statCard" prefWidth="220.0">
                    <Label text="Produits total" styleClass="statCard__label"/>
                    <Label fx:id="totalProductsLabel" text="0" styleClass="statCard__value"/>
                </VBox>
                <VBox spacing="4.0" styleClass="statCard" prefWidth="220.0">
                    <Label text="Produits actifs" styleClass="statCard__label"/>
                    <Label fx:id="activeProductsLabel" text="0" styleClass="statCard__value"/>
                </VBox>
                <VBox spacing="4.0" styleClass="statCard" prefWidth="220.0">
                    <Label text="Commandes total" styleClass="statCard__label"/>
                    <Label fx:id="totalOrdersLabel" text="0" styleClass="statCard__value"/>
                </VBox>
                <VBox spacing="4.0" styleClass="statCard" prefWidth="220.0">
                    <Label text="Commandes payees" styleClass="statCard__label"/>
                    <Label fx:id="paidOrdersLabel" text="0" styleClass="statCard__value"/>
                </VBox>
                <VBox spacing="4.0" styleClass="statCard" prefWidth="260.0">
                    <Label text="Revenue paye" styleClass="statCard__label"/>
                    <Label fx:id="paidRevenueLabel" text="0.00 DT" styleClass="statCard__value"/>
                </VBox>
                <VBox spacing="4.0" styleClass="statCard" prefWidth="220.0">
                    <Label text="Avis produits" styleClass="statCard__label"/>
                    <Label fx:id="reviewsCountLabel" text="0" styleClass="statCard__value"/>
                </VBox>
                <VBox spacing="4.0" styleClass="statCard" prefWidth="220.0">
                    <Label text="Note moyenne" styleClass="statCard__label"/>
                    <Label fx:id="averageRatingLabel" text="0.00/5" styleClass="statCard__value"/>
                </VBox>
            </FlowPane>

            <VBox spacing="10.0" styleClass="panel">
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label text="EVOLUTION JOURNALIERE" styleClass="panel-title"/>
                </HBox>
                <VBox fx:id="salesSeriesBox" spacing="6.0"/>
            </VBox>

            <HBox spacing="12.0">
                <VBox spacing="10.0" styleClass="panel" HBox.hgrow="ALWAYS">
                    <Label text="TOP PRODUITS VENDUS" styleClass="panel-title"/>
                    <VBox fx:id="topSellingBox" spacing="8.0"/>
                </VBox>

                <VBox spacing="10.0" styleClass="panel" HBox.hgrow="ALWAYS">
                    <Label text="TOP PRODUITS NOTES" styleClass="panel-title"/>
                    <VBox fx:id="topRatedBox" spacing="8.0"/>
                </VBox>
            </HBox>
        </VBox>
    </content>
</ScrollPane>
