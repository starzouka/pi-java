<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pulse.desktop.ui.AdminTeamsController"
            fx:id="pageScroll"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
    <content>
        <VBox spacing="16.0" styleClass="page-root">
            <padding>
                <Insets top="18.0" right="18.0" bottom="22.0" left="18.0"/>
            </padding>

            <VBox spacing="8.0" styleClass="hero-mini-box">
                <Label text="ADMIN" styleClass="heroKicker"/>
                <Label text="Gestion equipes" styleClass="heroMini__title"/>
                <Label text="CRUD complet + filtres DB + export." wrapText="true" styleClass="heroMini__sub"/>
            </VBox>

            <VBox spacing="10.0" styleClass="panel">
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label fx:id="formTitleLabel" text="NOUVELLE EQUIPE" styleClass="panel-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Nouvelle equipe" onAction="#startCreate" styleClass="btn-ghost"/>
                </HBox>

                <FlowPane hgap="10.0" vgap="10.0" prefWrapLength="1300.0">
                    <VBox spacing="4.0" prefWidth="360.0">
                        <Label text="Nom equipe *" styleClass="field-label"/>
                        <TextField fx:id="nameField" promptText="Nom equipe" styleClass="input"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="280.0">
                        <Label text="Region" styleClass="field-label"/>
                        <TextField fx:id="regionField" promptText="EU, NA, ..." styleClass="input"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="350.0">
                        <Label text="Capitaine *" styleClass="field-label"/>
                        <ComboBox fx:id="captainCombo" prefWidth="350.0"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="760.0">
                        <Label text="Description" styleClass="field-label"/>
                        <TextArea fx:id="descriptionArea" prefRowCount="4" wrapText="true" styleClass="textarea"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="760.0">
                        <Label text="Logo (fichier)" styleClass="field-label"/>
                        <HBox spacing="8.0">
                            <TextField fx:id="logoPathField" promptText="Aucun fichier" styleClass="input" HBox.hgrow="ALWAYS"/>
                            <Button text="Choisir" onAction="#chooseLogo" styleClass="btn-ghost"/>
                        </HBox>
                    </VBox>
                </FlowPane>

                <HBox spacing="8.0">
                    <Button fx:id="saveButton" text="Creer equipe" onAction="#saveTeam" styleClass="btn-primary"/>
                    <Button fx:id="cancelEditButton" text="Annuler edition" onAction="#cancelEdit" styleClass="btn-ghost" visible="false" managed="false"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="formFeedbackLabel" text="" styleClass="feedback-label"/>
                </HBox>
            </VBox>

            <VBox spacing="10.0" styleClass="panel">
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label text="FILTRES" styleClass="panel-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="resultCountLabel" text="0 resultat(s)" styleClass="badge-soft"/>
                    <Button text="Exporter PDF" onAction="#exportPdf" styleClass="btn-ghost"/>
                    <Button text="Exporter Excel" onAction="#exportExcel" styleClass="btn-ghost"/>
                </HBox>

                <FlowPane hgap="10.0" vgap="10.0" prefWrapLength="1300.0">
                    <VBox spacing="4.0" prefWidth="300.0">
                        <Label text="Recherche" styleClass="field-label"/>
                        <TextField fx:id="qField" promptText="nom, desc, captain" styleClass="input"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="220.0">
                        <Label text="Region" styleClass="field-label"/>
                        <TextField fx:id="regionFilterField" promptText="EU, NA, ..." styleClass="input"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="240.0">
                        <Label text="Capitaine" styleClass="field-label"/>
                        <TextField fx:id="captainFilterField" promptText="username / email" styleClass="input"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="170.0">
                        <Label text="Avec produits" styleClass="field-label"/>
                        <ComboBox fx:id="withProductsCombo" prefWidth="170.0"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="180.0">
                        <Label text="Tri" styleClass="field-label"/>
                        <ComboBox fx:id="sortCombo" prefWidth="180.0"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="150.0">
                        <Label text="Direction" styleClass="field-label"/>
                        <ComboBox fx:id="directionCombo" prefWidth="150.0"/>
                    </VBox>
                </FlowPane>

                <HBox spacing="8.0">
                    <Button text="Filtrer" onAction="#applyFilters" styleClass="btn-primary"/>
                    <Button text="Reset" onAction="#resetFilters" styleClass="btn-ghost"/>
                </HBox>
            </VBox>

            <VBox spacing="10.0" styleClass="panel">
                <Label text="LISTE" styleClass="panel-title"/>
                <VBox fx:id="teamsListBox" spacing="8.0"/>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
