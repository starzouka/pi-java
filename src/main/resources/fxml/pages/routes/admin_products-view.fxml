<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pulse.desktop.ui.AdminProductsController"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
    <content>
        <VBox spacing="16.0" styleClass="page-root">
            <padding>
                <Insets top="18.0" right="18.0" bottom="22.0" left="18.0"/>
            </padding>

            <VBox spacing="8.0" styleClass="hero-mini-box">
                <Label text="ADMIN" styleClass="heroKicker"/>
                <Label text="Gestion produits" styleClass="heroMini__title"/>
                <Label text="CRUD + filtres DB + export." wrapText="true" styleClass="heroMini__sub"/>
            </VBox>

            <VBox spacing="10.0" styleClass="panel">
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label fx:id="formTitleLabel" text="NOUVEAU PRODUIT" styleClass="panel-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Exporter PDF" onAction="#exportPdf" styleClass="btn-ghost"/>
                    <Button text="Exporter Excel" onAction="#exportExcel" styleClass="btn-ghost"/>
                </HBox>

                <FlowPane hgap="10.0" vgap="10.0" prefWrapLength="1300.0">
                    <VBox spacing="4.0" prefWidth="300.0">
                        <Label text="Equipe*" styleClass="field-label"/>
                        <ComboBox fx:id="teamCombo" prefWidth="300.0"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="300.0">
                        <Label text="Nom produit*" styleClass="field-label"/>
                        <TextField fx:id="nameField" styleClass="input"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="170.0">
                        <Label text="Prix*" styleClass="field-label"/>
                        <TextField fx:id="priceField" styleClass="input"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="150.0">
                        <Label text="Stock*" styleClass="field-label"/>
                        <TextField fx:id="stockField" styleClass="input"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="190.0">
                        <Label text="SKU" styleClass="field-label"/>
                        <TextField fx:id="skuField" styleClass="input"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="170.0">
                        <Label text="Actif" styleClass="field-label"/>
                        <ComboBox fx:id="activeCombo" prefWidth="170.0"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="640.0">
                        <Label text="Image URL" styleClass="field-label"/>
                        <TextField fx:id="imageUrlField" promptText="https://..." styleClass="input"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="1300.0">
                        <Label text="Description" styleClass="field-label"/>
                        <TextArea fx:id="descriptionArea" prefRowCount="3" wrapText="true" styleClass="textarea"/>
                    </VBox>
                </FlowPane>

                <HBox spacing="8.0">
                    <Button fx:id="saveButton" text="Creer produit" onAction="#saveProduct" styleClass="btn-primary"/>
                    <Button fx:id="cancelEditButton" text="Annuler edition" onAction="#cancelEdit" styleClass="btn-ghost" visible="false" managed="false"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="formFeedbackLabel" text="" styleClass="feedback-label"/>
                </HBox>
            </VBox>

            <VBox spacing="10.0" styleClass="panel">
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label text="FILTRES" styleClass="panel-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="resultCountLabel" text="0 resultat(s)" styleClass="badge-soft"/>
                </HBox>

                <FlowPane hgap="10.0" vgap="10.0" prefWrapLength="1300.0">
                    <VBox spacing="4.0" prefWidth="320.0">
                        <Label text="Recherche" styleClass="field-label"/>
                        <TextField fx:id="qField" promptText="name, sku, team" styleClass="input"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="220.0">
                        <Label text="Equipe" styleClass="field-label"/>
                        <ComboBox fx:id="teamFilterCombo" prefWidth="220.0"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="180.0">
                        <Label text="Actif" styleClass="field-label"/>
                        <ComboBox fx:id="activeFilterCombo" prefWidth="180.0"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="190.0">
                        <Label text="Tri" styleClass="field-label"/>
                        <ComboBox fx:id="sortCombo" prefWidth="190.0"/>
                    </VBox>
                    <VBox spacing="4.0" prefWidth="150.0">
                        <Label text="Direction" styleClass="field-label"/>
                        <ComboBox fx:id="directionCombo" prefWidth="150.0"/>
                    </VBox>
                </FlowPane>

                <HBox spacing="8.0">
                    <Button text="Filtrer" onAction="#applyFilters" styleClass="btn-primary"/>
                    <Button text="Reset" onAction="#resetFilters" styleClass="btn-ghost"/>
                </HBox>
            </VBox>

            <VBox spacing="10.0" styleClass="panel">
                <Label text="LISTE PRODUITS" styleClass="panel-title"/>
                <VBox fx:id="productsListBox" spacing="8.0"/>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
